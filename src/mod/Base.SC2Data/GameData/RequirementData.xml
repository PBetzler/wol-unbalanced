    <!-- Satisfied only by players holding the WoLUnbalancedFlag upgrade — which only
         our library ever grants (to the human player). Gates all WoLU clone abilities. -->
    <CRequirement id="WoLUHaveFlag">
        <NodeArray index="Use" Link="WoLUCountFlag"/>
    </CRequirement>
    <!-- Negation, for the vanilla branch of player-gated effect pairs (the campaign's
         NoShapedBlast pattern). -->
    <CRequirement id="WoLUNoFlagReq">
        <NodeArray index="Use" Link="WoLUNotCountFlag"/>
    </CRequirement>

