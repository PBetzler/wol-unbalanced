    <!-- Battlecruiser kit (unit-table: autocast Missile Pods + Defensive Matrix +
         Yamato on beefy targets). parent= inherits the full vanilla ability (cost,
         effect, range) so only autocast + the WoLUHaveFlag gate are added; this is
         the same append-don't-override approach as the Ghost kit (vanilla abilities
         untouched for enemy BCs; clones gated so only the flagged player uses them).
         Yamato autocast only fires at big targets (LifeMax >= 300) and never at
         structures — see WoLUYamatoBigTarget validator + the structure-excluding
         AutoCastFilters. NOTE/ASSUMPTION: defensive-structure discrimination (the
         table wants Yamato on Spine/turrets but not supply depots) is NOT solved —
         autocast skips ALL structures; manual Yamato still hits anything. -->
    <CAbilEffectTarget id="YamatoWoLU" parent="Yamato">
        <!-- Base Yamato has NO explicit <Effect> (it defaults to the "Yamato" effect via its
             own id). A clone re-defaults to ITS own id ("YamatoWoLU", nonexistent) and fires
             nothing — so pin the effect explicitly. (Caught by audit CHECK4.) -->
        <Effect index="0" value="Yamato"/>
        <Flags index="AutoCast" value="1"/>
        <Flags index="AutoCastOn" value="1"/>
        <AutoCastRange value="10"/>
        <AutoCastFilters value="Visible;Self,Player,Ally,Neutral,Structure,Missile,Stasis,Dead,Hidden,Invulnerable"/>
        <AutoCastValidatorArray value="WoLUYamatoBigTarget"/>
        <CmdButtonArray index="Execute" DefaultButtonFace="YamatoGun" Requirements="WoLUHaveFlag">
            <Flags index="ToSelection" value="1"/>
        </CmdButtonArray>
    </CAbilEffectTarget>
    <CAbilEffectTarget id="MissilePodsWoLU" parent="MissilePods">
        <Flags index="AutoCast" value="1"/>
        <Flags index="AutoCastOn" value="1"/>
        <AutoCastRange value="7"/>
        <AutoCastFilters value="Air,Visible;Self,Player,Ally,Neutral,Missile,Stasis,Dead,Hidden,Invulnerable"/>
        <CmdButtonArray index="Execute" DefaultButtonFace="MissilePods" Requirements="WoLUHaveFlag">
            <Flags index="ToSelection" value="1"/>
        </CmdButtonArray>
    </CAbilEffectTarget>
    <!-- ASSUMPTION/UNVERIFIED: Defensive Matrix is an INSTANT self-buff; autocast on
         a self-cast instant ability has no clean Blizzard blueprint (heal/snipe
         autocast are target abilities). These flags + an "enemy in range" gate are a
         best effort; the manual button always works. Flag for in-game check — if it
         never auto-fires, fall back to manual-only. -->
    <!-- Defensive Matrix is a SELF-buff instant (parent applies DefensiveMatrixSet to the
         caster). The old AutoCastFilters EXCLUDED Self/Ally (offensive-target form) so the
         autocast had no valid target and never fired. A self-buff autocasts like Stimpack:
         drive it off the caster's combat state, not a target filter. Mirror the verified
         StimpackWoLU pattern (CasterIsFiringWeapon) so the BC/SV auto-shields when fighting. -->
    <CAbilEffectInstant id="DefensiveMatrixWoLU" parent="DefensiveMatrix">
        <Flags index="AutoCast" value="1"/>
        <Flags index="AutoCastOn" value="1"/>
        <AutoCastRange value="5"/>
        <AutoCastValidatorArray value="CasterIsFiringWeapon"/>
        <CmdButtonArray index="Execute" DefaultButtonFace="DefensiveMatrix" Requirements="WoLUHaveFlag">
            <Flags index="ToSelection" value="1"/>
        </CmdButtonArray>
    </CAbilEffectInstant>

