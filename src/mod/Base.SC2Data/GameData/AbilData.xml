    </CAbilEffectInstant>

    <!-- #3: let ALL ground units (including mechanical) load into bunkers, each taking one
         slot. The vanilla BunkerTransport TargetFilters requires Biological ("Biological,
         Visible;Ally,Neutral,Enemy,Dead,Hidden") — a STRING field, so a per-player runtime
         edit is a silent no-op. Edit it in STATIC XML (global): drop Biological, keep it
         ground-only (add Air to the exclude list so it never loads air units). The
         MaxCargoCount / MaxCargoSize / TotalCargoSpace numbers that make every unit cost one
         slot are scalar fields that DO apply per player — set in genlib (MaxCargoCount=4,
         MaxCargoSize=8 to admit the size-8 Thor, TotalCargoSpace=32 so the unit COUNT binds
         before the size sum → 4 of anything fits, each = 1 slot). Global TargetFilters edit
         affects enemy bunkers too (negligible — enemies don't load mechanical). -->
    <CAbilTransport id="BunkerTransport">
        <TargetFilters value="Visible;Air,Ally,Neutral,Enemy,Dead,Hidden"/>
    </CAbilTransport>

    <!-- Medic Adaptive Medpacks (AP): heal MECHANICAL + air, not just biological ground.
         The vanilla `heal` gates on TargetFilters "Ground,Biological,..." — a STRING field,
         and per-player string edits are silent no-ops (the genlib attempt never took, user
         report). So clone `heal` (inherits the autocast, heal effect, range, sorts) and
         override TargetFilters to allow any visible friendly non-structure unit (mechanical
         AND biological, ground AND air). Appended to the Medic alongside vanilla heal
         (enemy medics keep vanilla); both autocast, so the player's medic auto-heals
         everything. Button gated WoLUHaveFlag. -->
    <CAbilEffectTarget id="HealWoLU" parent="heal">
        <!-- Vanilla `heal` has no explicit Effect (defaults to its own id = the "heal"
             CEffectCreateHealer). A clone re-defaults to its OWN id "HealWoLU" (nonexistent)
             and would heal nothing — so set the effect explicitly to "heal". -->
        <Effect index="0" value="heal"/>
        <TargetFilters value="Visible;Self,Enemy,Structure,Missile,UnderConstruction,Dead,Hidden,Invulnerable"/>
        <CmdButtonArray index="Execute" DefaultButtonFace="MedicHeal" Requirements="WoLUHaveFlag"/>
    </CAbilEffectTarget>
</Catalog>
