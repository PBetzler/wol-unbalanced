<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Thor ground weapon clone, wired into WeaponArray[1] by XML index-override in
         UnitData.xml. That override is GLOBAL (enemy Thors get this weapon too), so
         the clone must stay stat-identical to vanilla: the only change is the effect
         set, whose branches are player-gated (see EffectData.xml). Player-only stat
         buffs (DamagePoint windup cap) are applied per player at runtime on THIS id
         — never baked in here, where they would leak to enemies. -->
    <CWeaponLegacy id="ThorsHammerWoLU" parent="ThorsHammer">
        <Effect value="ThorsHammerWoLUSet"/>
    </CWeaponLegacy>
</Catalog>
