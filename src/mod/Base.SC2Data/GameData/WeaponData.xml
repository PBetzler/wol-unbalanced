<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Thor ground splash WITHOUT a weapon clone. Cloning the weapon (ThorsHammerWoLU)
         broke the attack visual, because the Thor's animation actors bind to
         WeaponStart.ThorsHammer (the weapon ID). So instead we keep the vanilla
         weapon ID and only override its Effect to our player-gated set — the weapon
         animation fires for everyone, and the splash-vs-vanilla split happens at the
         effect level (Shaped Blast pattern, see EffectData.xml). Global edit, but the
         effect set's branches are validator-gated so enemy Thors deal vanilla damage.
         Per-player windup cap stays on the vanilla ThorsHammer id in genlib. -->
    <CWeaponLegacy id="ThorsHammer">
        <Effect value="ThorsHammerWoLUSet"/>
        <!-- #2: simultaneous air + ground fire (Goliath Multi-Lock pattern). A Thor with
             two weapons (JavelinMissileLaunchers AA + ThorsHammer AG) fires only one at a
             time because, with no Options block, LinkedCooldown defaults to 1 (the weapons
             share one cooldown clock). The proven WoL pattern is the Goliath's *Upgraded
             weapons (GoliathGUpgraded / GoliathAUpgraded), which carry LinkedCooldown=0 +
             OnlyFireWhileInAttackOrder=0 + OnlyFireAtAttackOrderTarget=0 — exactly the
             independent-fire flags (the MultilockTargetingSystems upgrade only un-hides
             them; the flags live on the weapon defs, verified in the reference). Replicate
             them on both Thor weapons (and Odin's below)
             so each weapon acquires + fires its own target type independently.
             Options[] is an INDEXED array (a per-player CatalogFieldValueModify on it is a
             silent no-op), so this must live in STATIC XML — it is therefore GLOBAL and
             also enables enemy Thors to fire both weapons. Accepted tradeoff (negligible:
             few/zero enemy Thors in WoL; same precedent as the global bunker TargetFilters
             edit). Owner verifies the Jotun/Thor fires air + ground at once. -->
        <Options index="LinkedCooldown" value="0"/>
        <Options index="OnlyFireWhileInAttackOrder" value="0"/>
        <Options index="OnlyFireAtAttackOrderTarget" value="0"/>
    </CWeaponLegacy>
    <!-- #2: the Thor AA weapon needs the same independent-fire Options so it fires alongside
         ThorsHammer. (#8 splash is wired below via the JavelinMissileLaunchersLM impact set.) -->
    <CWeaponLegacy id="JavelinMissileLaunchers">
        <Options index="LinkedCooldown" value="0"/>
        <Options index="OnlyFireWhileInAttackOrder" value="0"/>
        <Options index="OnlyFireAtAttackOrderTarget" value="0"/>
        <!-- Panel truth (CHECK11): the AA reroute lives on the missile's ImpactEffect
             (JavelinMissileLaunchersLM → …WoLUSet in EffectData.xml), but the unit-info panel
             reads THIS weapon's DisplayEffect, vanilla-pinned to JavelinMissileLaunchersDamage
             (per-player Amount Set to 35 in genlib, but AttributeBonus[Light]=4 unchanged → the
             panel shows "+4 vs Light"). The player actually fires JavelinMissileLaunchersDamageBuffedWoLU
             = flat 35, Light bonus 0. Repoint DisplayEffect to that buffed clone so the panel
             shows the flat 35 (no phantom +4 Light) the player really deals. DisplayEffect is
             DISPLAY-ONLY → rule-9-safe (enemy damage/panels untouched). DisplayAttackCount=4 is a
             constant multiplier applied identically to the old and new DisplayEffect, so the
             per-rocket repoint keeps the panel's ×4 total correct. -->
        <DisplayEffect value="JavelinMissileLaunchersDamageBuffedWoLU"/>
    </CWeaponLegacy>
    <!-- #2 parity (rule 10): Odin (= hero Thor) gets the same simultaneous air+ground fire.
         Odin's weapons are OdinAntiAir (AA) + Odin (AG). -->
    <CWeaponLegacy id="Odin">
        <Options index="LinkedCooldown" value="0"/>
        <Options index="OnlyFireWhileInAttackOrder" value="0"/>
        <Options index="OnlyFireAtAttackOrderTarget" value="0"/>
    </CWeaponLegacy>
    <CWeaponLegacy id="OdinAntiAir">
        <Options index="LinkedCooldown" value="0"/>
        <Options index="OnlyFireWhileInAttackOrder" value="0"/>
        <Options index="OnlyFireAtAttackOrderTarget" value="0"/>
    </CWeaponLegacy>

    <!-- Viking ground (Assault) attack: Shredder Rounds (splash) + Anti-Mechanical Munition
         (bonus vs Mechanical). Same approach as Thor — keep the vanilla weapon id (attack
         animation binds to it), redirect its Effect to a player-gated effect set. The vanilla
         TwinGatlingCannons effect has no AreaArray/AttributeBonus, so these can only be added
         via a clone (runtime array-create is a no-op). Enemy Vikings hit the vanilla branch. -->
    <CWeaponLegacy id="TwinGatlingCannon">
        <Effect value="TwinGatlingCannonsWoLUSet"/>
        <!-- Panel truth (CHECK11): the unit-info damage panel reads the weapon's DisplayEffect,
             which vanilla pins to TwinGatlingCannons (14, no bonus) — but the PLAYER fires the
             buffed clone TwinGatlingCannonsWoLU (14 + AttributeBonus[Mechanical]=20). Repoint
             DisplayEffect to the player-fired clone so the panel shows the +20 vs Mechanical the
             player actually deals. DisplayEffect is DISPLAY-ONLY (never changes damage dealt), so
             this is rule-9-safe: enemy actual damage is untouched and enemy panels are never
             rendered to the player. (Splash radius is never panel-shown — out of scope.) -->
        <DisplayEffect value="TwinGatlingCannonsWoLU"/>
    </CWeaponLegacy>

    <!-- Hel's Angels (Viking merc, player-exclusive): same Shredder + Anti-Mech as the base
         Viking, scaled up for the merc % advantage. No flag gate needed (no enemy uses this
         merc weapon); redirect the weapon's Effect to the TRIGGER-OVERRIDE set
         WreckingCrewAssaultWoLUSet (member[0] = the unmodified vanilla WreckingCrewAssault effect,
         which keeps the vanilla CActorAction id="WreckingCrewAssaultAttack" firing -> the ground
         launch/impact muzzle is RESTORED; member[1] = the splash clone). Earlier this pointed at
         the bare clone WreckingCrewAssaultWoLU, which detached the action's muzzle/impact. -->
    <CWeaponLegacy id="WreckingCrewAssault">
        <Effect value="WreckingCrewAssaultWoLUSet"/>
    </CWeaponLegacy>

    <!-- Senior Ghost (MercSeniorGhost) rifle clone — player-exclusive, NO flag gate (no enemy
         uses MercSeniorGhost; same TRIGGER-OVERRIDE pattern as WreckingCrewAssault above).
         parent="C10CanisterRifle" inherits Range/Period/etc., so the merc keeps the base Ghost's
         +1 LTS range (genlib's per-player C10CanisterRifle.Range=7 reaches this child via read-
         time parent inheritance — the GAME-confirmed Thor precedent). Do NOT add a genlib Range
         edit for this id — the parent edit already covers it.
         <Effect> = the TRIGGER-OVERRIDE set C10CanisterRifleWoLUSet (EffectData.xml), whose
         member[0] is the UNMODIFIED vanilla C10CanisterRifle, so the bare id STILL FIRES -> the
         vanilla CActorAction id="GhostAttack" (effectAttack="C10CanisterRifle") keeps matching and
         the merc's rifle muzzle/impact (Ghost_AttackLaunch/Ghost_AttackImpact) are RESTORED. The
         set's member[1] is the +50% clone C10CanisterRifleWoLU (30 / +15 Light). The merc's target
         now takes the base hit (~20 / +10 Light) AND the +50% clone — owner-APPROVED damage
         increase. <DisplayEffect> stays C10CanisterRifleWoLU (the +50% clone the player intends to
         showcase); CHECK11 treats the un-gated set as "vanilla delivery — no damage clone" and skips
         the panel compare (the clone member is ungated, not WoLUHasFlag). The MercSeniorGhost unit
         overrides its WeaponArray to this weapon (UnitData.xml). -->
    <CWeaponLegacy id="C10CanisterRifleWoLU" parent="C10CanisterRifle">
        <Effect value="C10CanisterRifleWoLUSet"/>
        <DisplayEffect value="C10CanisterRifleWoLU"/>
    </CWeaponLegacy>

    <!-- Wraith Trigger Override: redirect both Wraith weapons' Effect to the stacking sets
         (keeps the weapon ids → attack animations bind). The added on-fire buff is
         WoLUHasFlag-gated at the effect level, so enemy Wraiths stay vanilla. -->
    <CWeaponLegacy id="WraithA">
        <Effect value="WraithATriggerOverrideSet"/>
    </CWeaponLegacy>
    <CWeaponLegacy id="WraithG">
        <Effect value="WraithGTriggerOverrideSet"/>
    </CWeaponLegacy>

    <!-- (Removed v0.3.25: the Raven SELF Point-Defense Laser weapon PointDefenseLaserWoLU. The
         static-weapon approach never auto-fired in game. Now replaced (v0.3.x) by the PASSIVE periodic
         behavior WoLURavenPointDefense (BehaviorData → WoLURavenPDSearch → vanilla PointDefenseLaserDamage),
         attached player-only in LibWoLUnbalanced.galaxy — it fires regardless of the Raven's order queue so
         point-defense works while the Raven moves. Its whole old effect/validator cluster was deleted too —
         see EffectData.xml / ValidatorData.xml / UnitData.xml.) -->

    <!-- DukesRevenge (Jackson's Revenge) long-range cannons: bump Range 6→8 to match the Loki's
         ArmageddonCannons (Range 8). DRCannonsG/DRCannonsA are DukesRevenge-EXCLUSIVE weapon ids
         (no other unit links them — the vanilla BC fires ATSLaserBattery/ATALaserBattery), so a
         same-id override is player-only (rule 9). Partial override = only Range changes; the
         inherited MinimumRange=2 and all other fields merge through untouched. The short-range
         DRBattlecruiserG/A (Range 2) + the fake/equipment display weapons are deliberately left alone. -->
    <CWeaponLegacy id="DRCannonsG">
        <Range value="8"/>
    </CWeaponLegacy>
    <CWeaponLegacy id="DRCannonsA">
        <Range value="8"/>
    </CWeaponLegacy>
</Catalog>
