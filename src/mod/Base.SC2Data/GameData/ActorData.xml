<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Magrail railgun beam. Cloned from NCO's RailGunTurretAttackBeamPoint (a
         complete working railgun beam): a one-shot beam created when the Magrail
         damage effect fires, drawn from the marine's weapon to the target, using the
         base-game WarHound railgun model (WoLUMagrailBeamModel = the real .m3, by CASC
         path — no bundling/NCO-data dependency). This is the authentic magrail visual.
         FLAG: authored without in-game iteration — verify it renders; the parents
         (BeamSimpleAnimationStyleOneShot) and the Effect.<id>.Start binding are taken
         verbatim from the working NCO actor, so this is a faithful clone, not a guess. -->
    <CActorBeamSimple id="WoLUMagrailBeam" parent="BeamSimpleAnimationStyleOneShot">
        <On Terms="Effect.MagrailDamageWoLU.Start; At Caster" Send="Create"/>
        <Model value="WoLUMagrailBeam"/>
        <HostLaunch Subject="_Unit"/>
        <HostLaunchSiteOps Ops="SOpAttachWeapon" HoldPosition="1"/>
        <HostImpactSiteOps Ops="SOpTargetPoint"/>
    </CActorBeamSimple>
    <!-- Railgun impact flash at the target. -->
    <CActorModel id="WoLUMagrailImpactActor" parent="ModelAnimationStyleOneShot">
        <On Terms="Effect.MagrailDamageWoLU.Start" Send="Create"/>
        <Model value="WoLUMagrailImpact"/>
        <HostSiteOps Ops="SOpTargetPoint"/>
    </CActorModel>

    <!-- Science Vessel auto-heal AURA visual (v0.3.25+): the WoLUSVHealAura behavior heals all
         nearby friendlies +15 Life every 1 s (BehaviorData.xml → WoLUSVHealAuraSearch area enum →
         WoLUSVHealAuraHeal CEffectModifyUnit, EffectData.xml), but the heal was INVISIBLE. This
         plays a one-shot green heal glow over each healed unit on every WoLUSVHealAuraHeal tick.
         REUSES the engine-loaded vanilla heal model token MedicHealModel (proven loaded — vanilla
         Medivac/Medic/Bones/RaynorHealPack actors all use <Model value="MedicHealModel"/>; NO
         hand-typed .m3). Precedent = vanilla RaynorHealPackModel (CActorModel
         parent="ModelAnimationStyleOneShot", same Model + Effect.<id>.Start + Host _Unit +
         SOpAttachOverhead, self-destructs when the one-shot anim ends —
         mods/_reference/liberty.sc2campaign/ActorData.xml:9468). WoLUSVHealAuraHeal is an INSTANT
         CEffectModifyUnit fired once per tick per target, so we bind to its .Start (not the
         persistent .Start/.Stop channeled form) and let the one-shot auto-destroy. Host Subject=
         "_Unit" = the searched friendly (the effect's target = the HEALED unit), so the pulse shows
         over each healed unit. Player-only: WoLUSVHealAura is attached ONLY to the human player's
         Science Vessels via libWoLU_AddBehaviorToType, so this effect (and its visual) never fires
         on an enemy → the pulse never appears on enemy units. -->
    <CActorModel id="WoLUSVHealAuraPulse" parent="ModelAnimationStyleOneShot">
        <!-- REBOUND (v0.3.x) from Effect.WoLUSVHealAuraHeal.Start (~16x/s, far too busy) to
             Effect.WoLUSVHealAuraGlowMark.Start, which fires ONCE PER SECOND PER HEALED UNIT (driven by
             the separate 1.0 s WoLUSVHealAuraGlow behavior → WoLUSVHealAuraGlowPing search →
             WoLUSVHealAuraGlowMark marker). The HEAL stays granular (WoLUSVHealAuraHeal, 16x/s) — only the
             GLOW slowed to 1/s. Host _Unit = the searched friendly = the marker effect's TARGET (the HEALED
             unit), NOT the SV: an area-enum-applied CEffectModifyUnit (WoLUSVHealAuraGlowMark, applied by
             WoLUSVHealAuraGlowPing exactly as the heal is applied by WoLUSVHealAuraSearch) targets the
             searched unit, so Effect.<id>.Start's _Unit resolves to each healed target. SOpAttachOverhead
             puts the pulse over each healed unit's head. Precedent = vanilla RaynorHealPackModel (same
             Model + Effect.<id>.Start + Host _Unit + SOpAttachOverhead for an area-applied heal). -->
        <On Terms="Effect.WoLUSVHealAuraGlowMark.Start" Send="Create"/>
        <Model value="MedicHealModel"/>
        <Host Subject="_Unit"/>
        <HostSiteOps Ops="SOpAttachOverhead"/>
    </CActorModel>

    <!-- SV heal-RANGE ring (v0.3.x — owner request): a radius-7 circle on the player's Science Vessel
         showing its heal-aura reach. CActorRange needs NO .m3/.dds (engine-primitive ring). Keyed to
         Behavior.WoLUSVHealAura.On/Off → auto-hosts to the unit carrying the behavior (the SV) and is
         player-only BY CONSTRUCTION: WoLUSVHealAura is attached ONLY to the human player's SVs via
         libWoLU_AddBehaviorToType, so the ring never appears on an enemy SV (rule 9). No Galaxy change.
         Visibility lines copied VERBATIM from the verified vanilla NexusShieldOverchargeRange (and matching
         SensorTowerRadar): <Inherits index="Visibility" value="0"/> + <FogVisibility value="Visible"/> so
         the owner sees their own ring through fog. Range 7.0 == WoLUSVHealAuraSearch's AreaArray Radius.
         [GAME]-pending: all verified CActorRange examples attach to ground units/buildings; the SV is a
         FLYER, so the ring-on-a-flyer render needs owner confirmation. -->
    <CActorRange id="WoLUSVHealAuraRange">
        <Inherits index="Visibility" value="0"/>
        <FogVisibility value="Visible"/>
        <On Terms="Behavior.WoLUSVHealAura.On" Send="Create"/>
        <On Terms="Behavior.WoLUSVHealAura.Off" Send="Destroy"/>
        <Range value="7.000000"/>
    </CActorRange>

    <!-- Actors for the extra elite mercs. A unit actor MUST inherit GenericUnitBase and
         declare unitName= (that's what creates the model on birth + drives weapon/attack
         visuals) — a bare <Model>-only actor renders a sphere with no attack (the v0.2.0
         bug). The <Model> element reskins it to the base unit's model (cf. liberty's
         LiberatorSkinPreview = GenericUnitBase + unitName + Model="Liberator"). -->
    <!-- Portrait fix (issue 8 — heart portraits): the old custom Merc*Portrait CModels
         pointed at GUESSED .m3 paths (wrong → heart). Reference the BASE unit's portrait
         CModel id directly instead. These ids must exist: GenericUnitBase resolves the real
         unit's portrait via the ##unitName##Portrait token (Medic -> "MedicPortrait"), so
         "MedicPortrait" etc. are loaded, correct base-CASC portraits. (Body models already
         render via <Model> for the same reason.) -->
    <!-- Skibi's Angels: the vanilla Medic actor plays its heal-channel pose on
         Abil.heal.SourceChannelStart -> $Spell PlayForever / SourceChannelStop -> AnimClear
         Spell. A bare GenericUnitBase actor lacks it, so the merc stands still while healing
         (the heal beam/effect still shows). The PLAYER merc's visible heal button casts the
         HealWoLU clone (mechanical+air targeting), NOT vanilla heal — verified: Medic
         AbilArray[6]=HealWoLU + card button 6 re-pointed to HealWoLU,Execute, and MercMedic
         (parent="Medic") inherits both. HealWoLU is CAbilEffectTarget parent="heal" → same
         channel event structure → fires Abil.HealWoLU.SourceChannelStart/Stop. Key on HealWoLU
         (the cast that actually fires for the player); also key on vanilla heal so the pose
         still plays if the merc autocasts the inherited vanilla heal (harmless — this actor is
         worn only by the player-only merc). Skip the vanilla KillSquad ModelSwap (irrelevant).
         Source: mods/_reference/liberty.sc2campaign/ActorData.xml CActorUnit id="Medic". -->
    <CActorUnit id="MercMedic" parent="GenericUnitBase" unitName="MercMedic">
        <Model value="Medic"/>
        <PortraitModel value="MedicPortrait"/>
        <On Terms="Abil.HealWoLU.SourceChannelStart" Send="$Spell PlayForever"/>
        <On Terms="Abil.HealWoLU.SourceChannelStop" Send="AnimClear Spell"/>
        <On Terms="Abil.heal.SourceChannelStart" Send="$Spell PlayForever"/>
        <On Terms="Abil.heal.SourceChannelStop" Send="AnimClear Spell"/>
    </CActorUnit>
    <CActorUnit id="MercReaper" parent="GenericUnitBase" unitName="MercReaper">
        <Model value="Reaper"/>
        <PortraitModel value="ReaperPortrait"/>
    </CActorUnit>
    <!-- Condor: the vanilla Hellion actor kills its flame-beam (HellionAttackBeam) on a short
         timer whenever the unit walks or stops attacking, so the beam doesn't linger as the unit
         moves. A bare GenericUnitBase actor lacks these cleanup timers. Copy them verbatim
         (HellionAttackBeam + the KillBeam timer name are inherited unchanged via parent="Hellion"
         and the worn Hellion model). Source: mods/_reference/liberty.sc2mod/ActorData.xml
         CActorUnit id="Hellion". -->
    <CActorUnit id="MercHellion" parent="GenericUnitBase" unitName="MercHellion">
        <Model value="Hellion"/>
        <PortraitModel value="HellionPortrait"/>
        <On Terms="UnitMovementUpdate.*.Walk" Send="TimerSet 0.250000 KillBeam"/>
        <On Terms="Abil.attack.ReadyStop" Send="TimerSet 0.250000 KillBeam"/>
        <On Terms="TimerExpired; TimerName KillBeam" Target="HellionAttackBeam" Send="Destroy"/>
    </CActorUnit>
    <!-- Jotun: Thor's attack animation events are bound to its SPECIFIC weapon ids
         (ground ThorsHammer, air JavelinMissileLaunchers) on the vanilla Thor actor; a
         bare GenericUnitBase actor only has the generic WeaponStart.*.AttackStart bracket,
         so the Thor model plays its air-cover pose against ground targets and never fires
         the ground muzzle. Copy the vanilla Thor actor's weapon-anim events verbatim (the
         weapons exist on MercThor via parent="Thor", the anims exist in the Thor model we
         wear) so the ground attack animates + muzzles correctly. -->
    <CActorUnit id="MercThor" parent="GenericUnitBase" unitName="MercThor">
        <Model value="Thor"/>
        <PortraitModel value="ThorPortrait"/>
        <On Terms="Abil.attack.ReadyStart" Send="AnimGroupApply Ready"/>
        <On Terms="ActorCreation" Send="AnimPlay CoverStand Cover,Stand PlayForever 0.000000"/>
        <On Terms="WeaponStart.JavelinMissileLaunchers.AttackStart" Send="TimerKill CoverDelay"/>
        <On Terms="WeaponStart.JavelinMissileLaunchers.AttackStart" Send="AnimClear CoverStand"/>
        <On Terms="WeaponStart.JavelinMissileLaunchers.AttackStart" Send="AnimPlay Cover Cover PlayForever"/>
        <On Terms="WeaponStop.JavelinMissileLaunchers.AttackStop" Send="TimerSet 2.500000 CoverDelay"/>
        <On Terms="TimerExpired; TimerName CoverDelay" Send="AnimClear Cover"/>
        <On Terms="TimerExpired; TimerName CoverDelay" Send="AnimPlay CoverStand Cover,Stand PlayForever"/>
        <On Terms="WeaponStart.ThorsHammer.AttackStart; WeaponTargetElevation GE 20.000000" Send="AnimBracketStart Attack Attack,Superior"/>
        <On Terms="WeaponStart.ThorsHammer.AttackStart; WeaponTargetElevation LE -20.000000" Send="AnimBracketStart Attack Attack,Inferior"/>
        <On Terms="WeaponStart.ThorsHammer.AttackStart; WeaponTargetDistance LE 1.000000" Send="AnimBracketStart Attack Spell,B"/>
        <On Terms="WeaponStart.ThorsHammer.AttackStart" Send="AnimBracketStart Attack Attack"/>
        <On Terms="WeaponStop.*.AttackStop" Send="AnimBracketStop Attack"/>
        <On Terms="Abil.attack.ReadyStop" Send="AnimGroupRemove Ready"/>
    </CActorUnit>
    <!-- Winged Nightmares: the Wraith splits its attack pose by weapon on the vanilla actor —
         air WraithA plays the upward Attack,Superior bracket, ground WraithG plays the base
         Attack bracket. A bare GenericUnitBase actor only has the generic
         WeaponStart.*.AttackStart bracket, so the air attack never gets the upward-aim pose.
         Copy the vanilla Wraith actor's weapon-anim events verbatim (WraithA/WraithG are
         inherited unchanged via parent="Wraith"; the anims live in the Wraith model we wear).
         Source: mods/_reference/liberty.sc2campaign/ActorData.xml CActorUnit id="Wraith". -->
    <CActorUnit id="MercWraith" parent="GenericUnitBase" unitName="MercWraith">
        <Model value="Wraith"/>
        <PortraitModel value="WraithPortrait"/>
        <On Terms="Abil.attack.ReadyStart" Send="AnimGroupApply Ready"/>
        <On Terms="WeaponStart.WraithA.AttackStart" Send="AnimBracketStart Attack Attack,Superior"/>
        <On Terms="WeaponStart.WraithG.AttackStart" Send="AnimBracketStart Attack Attack"/>
        <On Terms="WeaponStop.*.AttackStop" Send="AnimBracketStop Attack"/>
        <On Terms="Abil.attack.ReadyStop" Send="AnimGroupRemove Ready"/>
    </CActorUnit>
    <!-- Senior Ghost wears the GhostAlternate model (a ghost variant in liberty.sc2mod);
         portrait = the base Ghost portrait. A bare GenericUnitBase actor lacks the Ghost's
         spell-cast poses + the elevation-aim rifle bracket, so EMP/Snipe/nuke fire with no
         caster animation. Copy the GhostAlternate actor's combat + spell-cast events
         (mods/_reference/liberty.sc2mod/ActorData.xml CActorUnit id="GhostAlternate", which is
         the model worn here and carries the same event set as the Ghost actor), RE-KEYED to the
         abilities the merc ACTUALLY casts:
           - Snipe -> SnipeWoLU  (our autocast clone the player's button casts; verified the
             vanilla Snipe slot is APPENDED-alongside + card button 7 re-pointed to SnipeWoLU);
           - EMP -> EMPWoLU      (same pattern, card button 11 re-pointed);
           - TacNukeStrike + GhostHoldFireB keep their UNCHANGED vanilla ids (inherited slots,
             not re-pointed — MercSeniorGhost has both via parent="Ghost").
         The rifle WeaponStart Attack bracket (weapon id inherited unchanged) is copied verbatim
         with its Superior/Inferior elevation variants. The SpellC walk-cancel cleanup carries no
         ability id (generic) → verbatim. SKIP the Ghost->GhostAlternate morph Destroy event (the
         merc is not a morphing unit). -->
    <CActorUnit id="MercSeniorGhost" parent="GenericUnitBase" unitName="MercSeniorGhost">
        <Model value="GhostAlternate"/>
        <PortraitModel value="GhostPortrait"/>
        <On Terms="Abil.TacNukeStrike.SourceCastStart" Send="AnimPlay SpellA Spell,A"/>
        <On Terms="Abil.TacNukeStrike.SourceCastStop" Send="AnimClear SpellA"/>
        <On Terms="Abil.TacNukeStrike.SourceChannelStart" Send="AnimPlay SpellB Spell,B PlayForever"/>
        <On Terms="Abil.TacNukeStrike.SourceChannelStop" Send="AnimClear SpellB"/>
        <On Terms="Abil.TacNukeStrike.SourceFinishStart" Send="AnimPlay SpellC Spell,C"/>
        <On Terms="Abil.TacNukeStrike.SourceFinishStop" Send="AnimClear SpellC"/>
        <On Terms="Abil.SnipeWoLU.SourceCastStart" Send="AnimBaselineStop"/>
        <On Terms="Abil.SnipeWoLU.SourceCastStart" Send="AnimPlay SpellA Spell,A"/>
        <On Terms="Abil.SnipeWoLU.SourceCastStop" Send="AnimClear SpellA"/>
        <On Terms="Abil.SnipeWoLU.SourceCastStop" Send="AnimBaselineStart"/>
        <On Terms="Abil.SnipeWoLU.SourceChannelStart" Send="AnimPlay SpellB Spell,B PlayForever"/>
        <On Terms="Abil.SnipeWoLU.SourceChannelStop" Send="AnimClear SpellB"/>
        <On Terms="Abil.SnipeWoLU.SourceFinishStart" Send="AnimPlay SpellC Spell,C"/>
        <On Terms="UnitMovementUpdate.*.Walk; AnimPlaying SpellC" Send="AnimClear SpellC"/>
        <On Terms="Abil.EMPWoLU.SourceCastStart" Send="AnimPlay SpellC Spell,C 0 0.000000 0.300000"/>
        <On Terms="Abil.attack.ReadyStart" Send="AnimGroupApply Ready"/>
        <On Terms="Behavior.GhostHoldFireB.On" Send="AnimGroupApply Cover"/>
        <On Terms="Behavior.GhostHoldFireB.On" Send="AnimPlay MorphStart Cover,Start"/>
        <On Terms="Behavior.GhostHoldFireB.On" Send="AnimClear MorphEnd"/>
        <On Terms="Behavior.GhostHoldFireB.On" Send="Create Ghost_HoldFire_Sound"/>
        <On Terms="Behavior.GhostHoldFireB.Off" Send="AnimPlay MorphEnd Cover,End"/>
        <On Terms="Behavior.GhostHoldFireB.Off" Send="AnimClear MorphStart"/>
        <On Terms="Behavior.GhostHoldFireB.Off" Send="AnimGroupRemove Cover"/>
        <On Terms="Behavior.GhostHoldFireB.Off" Send="Create Ghost_WeaponsFree_Sound"/>
        <On Terms="WeaponStart.*.AttackStart; WeaponTargetElevation GE 20.000000" Send="AnimBracketStart Attack Attack,Superior"/>
        <On Terms="WeaponStart.*.AttackStart; WeaponTargetElevation LE -20.000000" Send="AnimBracketStart Attack Attack,Inferior"/>
        <On Terms="WeaponStart.*.AttackStart" Send="AnimBracketStart Attack Attack"/>
        <On Terms="WeaponStop.*.AttackStop" Send="AnimBracketStop Attack"/>
        <On Terms="Abil.attack.ReadyStop" Send="AnimGroupRemove Ready"/>
    </CActorUnit>
    <!-- Jotun (MercThorWreckage) wreck actor. The MercThor merc resurrects via a parallel
         Immortality Protocol chain (MercThorDontDie -> MercThorWreckage unit -> MercThorReborn).
         The wreck unit is a NEW id, so it needs its own CActorUnit or it renders as a sphere
         (audit CHECK1). Clone the vanilla ThorWreckage actor (parent="ThorWreckage" inherits its
         sounds/icons/wireframe/portrait) and re-bind the morph-birth events to OUR unit id
         (MorphTo/UnitBirth MercThorWreckage). Wear the Thor model explicitly (the wreck is a
         rebuilding Thor; explicit Model avoids any clone model-token resolution risk — same
         pattern as the MercThor body actor). -->
    <CActorUnit id="MercThorWreckage" parent="ThorWreckage" unitName="MercThorWreckage">
        <Model value="Thor"/>
        <On Terms="AbilMorph.*.Finish; MorphTo MercThorWreckage" Send="$Birth 0 1.000000 1.000000"/>
        <On Terms="UnitBirth.MercThorWreckage.Suppressed" Send="$Stand PlayForever,NonLooping"/>
    </CActorUnit>

    <!-- (MercLiberator/MercLiberatorAG/MercValkyrie actors removed with their units.) -->

    <!-- (REMOVED v0.3.31 — the Thor/Viking/Hel's-Angels GROUND + Thor/Jotun AA action-clone
         re-binds: ThorAttack{Vanilla,}WoLU, ThorAAAttack{Vanilla,}WoLU, VikingAssaultAttack{Vanilla,}WoLU,
         WreckingCrewAssaultAttackWoLU. These cloned the vanilla CActorAction (parent="<vanilla action>"
         + a re-specified effectAttack/effectImpact pointing at the rerouted child effect ids) to try to
         restore the launch muzzle / impact / blood that the weapon-Effect reroute detached. They did NOT
         re-bind in-game: shipped v0.3.11 -> v0.3.30, the owner still saw NO muzzle/launch flash, no
         projectile, no impact on the Jotun/Thor + Viking ground attacks. The WORKING fix is the
         Trigger-Override shape applied in EffectData.xml / WeaponData.xml: each reroute SET now
         RE-INCLUDES the UNMODIFIED vanilla delivery/damage effect as member[0]
         (ThorsHammerDamage / JavelinMissileLaunchersDamage / TwinGatlingCannons / WreckingCrewAssault),
         so the bare id STILL FIRES and the UNTOUCHED vanilla CActorActions (ThorAttack, ThorAAAttack,
         VikingAssaultAttack, WreckingCrewAssaultAttack) keep matching -> their muzzle/impact actors fire
         again with zero action clones. See docs/learnings.md (the reroute-universe section). The vanilla
         actions are intentionally left UNTOUCHED here. -->
</Catalog>
