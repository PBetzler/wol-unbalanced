<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Player gate for shared (non-requirement-gated) clone wiring, e.g. weapon
         effects: same pattern as the campaign's HasShapedBlast/NoShapedBlast
         (CValidatorPlayerRequirement on sibling effects). Only our library ever
         grants WoLUnbalancedFlag, and only to the human player. -->
    <CValidatorPlayerRequirement id="WoLUHasFlag">
        <Find value="1"/>
        <Value value="WoLUHaveFlag"/>
    </CValidatorPlayerRequirement>
    <CValidatorPlayerRequirement id="WoLUNoFlag">
        <Find value="1"/>
        <Value value="WoLUNoFlagReq"/>
    </CValidatorPlayerRequirement>

    <!-- Raven self Point-Defense Laser firing floor: the firing Raven (Caster) needs >= 1 energy
         to intercept (it pays 1 per intercept via PointDefenseLaserEnergyWoLU). Same shape as
         liberty's CasterHas10Energy (WhichUnit=Caster, Vital=Energy), threshold lowered to 1. -->
    <CValidatorUnitCompareVital id="WoLUCasterHas1Energy">
        <WhichUnit Value="Caster"/>
        <Compare value="GE"/>
        <Value value="1"/>
        <Vital value="Energy"/>
    </CValidatorUnitCompareVital>

    <!-- EMP autocast gate: only fire at targets that actually have energy or shields
         (schema verbatim from liberty's healCasterMinEnergy, WhichUnit=Target). -->
    <CValidatorUnitCompareVital id="WoLUTargetHasEnergy">
        <Compare value="GT"/>
        <Value value="0"/>
        <Vital value="Energy"/>
        <WhichUnit Value="Target"/>
    </CValidatorUnitCompareVital>
    <CValidatorUnitCompareVital id="WoLUTargetHasShields">
        <Compare value="GT"/>
        <Value value="0"/>
        <Vital value="Shields"/>
        <WhichUnit Value="Target"/>
    </CValidatorUnitCompareVital>
    <CValidatorCombine id="WoLUTargetEnergyOrShields">
        <Type value="Or"/>
        <CombineArray value="WoLUTargetHasEnergy"/>
        <CombineArray value="WoLUTargetHasShields"/>
    </CValidatorCombine>

    <!-- Yamato autocast gate: only worth it on a beefy target. Compares the target's
         MAX life (CValidatorUnitCompareField reads any unit field; default WhichUnit
         is the validated/target unit, as TargetRadiusLarge does). ASSUMPTION: the
         table says "max HP + max shields >= 300"; WoL campaign enemies are Terran/
         Zerg (no shields), so LifeMax >= 300 is equivalent here. -->
    <CValidatorUnitCompareField id="WoLUYamatoBigTarget">
        <Compare value="GE"/>
        <Field value="LifeMax"/>
        <Value value="300"/>
    </CValidatorUnitCompareField>

    <!-- (WoLUCasterDamaged removed in the Defensive-Matrix on-damage rework.) The old
         "caster Life < 100%" validator gated a STATE-based autocast that re-cast the shield
         every cooldown while the unit merely sat below full HP. Defensive Matrix is now
         event-driven via the WoLUDefMatrixOnDamage DamageResponse behavior (BehaviorData.xml),
         so this validator has no remaining reference and is deleted. -->

    <!-- Snipe autocast floor: don't waste a 45-dmg Snipe on a target with < 30
         current life (the table's "max 15 HP wasted" intent, as a floor). Current
         life, not max — a wounded heavy can still be a clean kill. -->
    <CValidatorUnitCompareVital id="WoLUSnipeWorthwhile">
        <Compare value="GE"/>
        <Value value="30"/>
        <Vital value="Life"/>
        <WhichUnit Value="Target"/>
    </CValidatorUnitCompareVital>

    <!-- Smart-Snipe priority validators (used by custom CTargetSort entries — see
         TargetSortData.xml). Sort-direction convention confirmed from the RaynorRogue
         kit's BattlecruiserWeaponSwitch: a plain CTargetSortValidator sorts passers
         LAST, so Descending=1 puts passers FIRST. -->
    <!-- Tier 2: Snipe (45) is lethal now — clean kill, no overkill waste beyond 15. -->
    <CValidatorUnitCompareVital id="WoLUSnipeLethal">
        <Compare value="LE"/>
        <Value value="45"/>
        <Vital value="Life"/>
        <WhichUnit Value="Target"/>
    </CValidatorUnitCompareVital>
    <!-- Tier 1: healers first. JUDGMENT CALL: WoL enemy healers are Medic + Medivac;
         this set is a reasonable choice, not an engine-defined "healer" flag. -->
    <CValidatorUnitType id="WoLUTargetIsMedic">
        <WhichUnit Value="Target"/>
        <Value value="Medic"/>
    </CValidatorUnitType>
    <CValidatorUnitType id="WoLUTargetIsMedivac">
        <WhichUnit Value="Target"/>
        <Value value="Medivac"/>
    </CValidatorUnitType>
    <CValidatorCombine id="WoLUTargetIsHealer">
        <Type value="Or"/>
        <CombineArray value="WoLUTargetIsMedic"/>
        <CombineArray value="WoLUTargetIsMedivac"/>
    </CValidatorCombine>

    <!-- ============================================================================
         Science Vessel Magellan FREE double-beam heal: periodic-sustain validators.
         The Medivac heal mechanism drains energy in TWO places: (a) the periodic
         MedivacHealModifySet's MedivacHealModifyCasterEnergy (-0.33/tick), gated alive
         by PeriodicValidator=HealPeriodicCombine which itself contains a CasterHasEnergy
         AND-member; (b) the ability-level healCasterMinEnergy (>=5 energy to auto-start),
         also carried by MedivacHealSearch's ValidatorArray. To make the SV heal FREE
         (like the old Nano-Repair beams + the mod's free-ability ethos) we drop BOTH on
         OUR clones only — the Medivac + enemy SVs keep the vanilla drain (rule 9).
         These validators are CREATABLE in static XML (validators have no per-player
         runtime catalog — learnings §"A VALIDATOR's threshold is NOT per-player-editable").
         ids verified against mods/_reference/campaigns/liberty.sc2campaign/ValidatorData.xml
         (HealPeriodicCombine :262, MedivacIsHealing :174) + liberty.sc2mod (CasterHasEnergy).
         ============================================================================ -->

    <!-- "This SV is running OUR heal ability." Vanilla MedivacIsHealing keys on
         AbilLink=MedivacDoubleBeamHeal, but the SV re-issues SVDoubleBeamHealWoLU, so the
         vanilla check would FAIL the periodic heal on the SV. Re-key it to our ability so
         the periodic life-restore actually ticks. (Same CValidatorUnitOrderQueue shape.) -->
    <CValidatorUnitOrderQueue id="SVIsHealingWoLU">
        <AbilLink value="SVDoubleBeamHealWoLU"/>
    </CValidatorUnitOrderQueue>

    <!-- The free-sustain periodic validator: clone of HealPeriodicCombine (an And) with the
         CasterHasEnergy member DROPPED (so the heal keeps ticking at 0 energy) and
         MedivacIsHealing swapped for SVIsHealingWoLU. Every other gate is kept verbatim
         (LifeGTZero, NotMaxHP, HealTargetInRange, NotHidden) so the beam still tears down
         when the target is full/dead/out-of-range/hidden — none of those is energy-related. -->
    <CValidatorCombine id="SVHealPeriodicCombineWoLU">
        <Type value="And"/>
        <CombineArray value="SVIsHealingWoLU"/>
        <CombineArray value="LifeGTZero"/>
        <CombineArray value="NotMaxHP"/>
        <CombineArray value="HealTargetInRange"/>
        <CombineArray value="NotHidden"/>
    </CValidatorCombine>

    <!-- The auto-acquire SCAN's keep-alive validator: clone of HealScanPeriodicCombine
         (an And of CasterHasEnergy + AtLeastOneHealBeamBusy) with the CasterHasEnergy member
         DROPPED so the channeled scan that grabs the 2nd target keeps running at 0 energy.
         AtLeastOneHealBeamBusy (>=1 beam currently busy) is KEPT — the scan should only run
         while at least one beam is active, exactly as vanilla. (HealScanPeriodicCombine :164;
         AtLeastOneHealBeamBusy :118.) -->
    <CValidatorCombine id="SVHealScanPeriodicCombineWoLU">
        <Type value="And"/>
        <CombineArray value="AtLeastOneHealBeamBusy"/>
    </CValidatorCombine>
</Catalog>
