<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Super Stimpack buff — verbatim clone of Nova Covert Ops "SuperStim"
         (novastoryassets.sc2mod BehaviorData.xml): same 1.5x move/attack speed and
         15 s duration as vanilla Stimpack. Adaptations: icon swapped to the WoL stim
         icon (the NCO texture isn't in Liberty), and the NCO-only Hellion
         remove-validator dropped (SourceIsNotHellion doesn't exist in Liberty). -->
    <CBehaviorBuff id="WoLUSuperStim">
        <Alignment value="Positive"/>
        <InfoIcon value="Assets\Textures\btn-ability-terran-stimpack.dds"/>
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <Duration value="15"/>
        <Modification MoveSpeedMultiplier="1.5" AttackSpeedMultiplier="1.5"/>
    </CBehaviorBuff>

    <!-- Predator Adaptive Defenses (AP). DamageResponse ModifyFraction halves incoming
         damage — schema verified verbatim against the Moebius mod's AdvancedShielding
         (mods/_reference/moebius BehaviorData.xml). SIMPLIFICATION: the table says
         "halves ranged/splash dmg"; the DamageResponse Kind-filter semantics are
         ambiguous in the reference (all Kinds set to 0), so this halves ALL incoming
         damage — slightly stronger, fits an overpowered mod, and avoids guessing the
         filter. Permanent + player-only: attached to player Predators via the periodic
         UnitBehaviorAdd in LibWoLUnbalanced.galaxy (rule 9 safe). -->
    <CBehaviorBuff id="WoLUAdaptiveDefenses">
        <Alignment value="Positive"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoIcon value="Assets\Textures\btn-ability-zeratul-sentry-reflectionshield.dds"/>
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <DamageResponse ModifyFraction="0.5" ModifyMinimumDamage="1">
            <Chance value="1"/>
        </DamageResponse>
    </CBehaviorBuff>

    <!-- Siege Tank Graduating Range (unit-table: sieged range grows +1 every 3 s, up
         to +5). One stack = +1 WeaponRange (Modification field confirmed from liberty
         BunkerWeaponRangeBonus); MaxStackCount caps at +5. The stacking is DRIVEN from
         the galaxy lib (libWoLU_GraduateSiegeRange, every 3 s adds one stack to player
         SiegeTankSieged/SiegeBreakerSieged up to 5) — a self-stacking PeriodicEffect
         buff has no verbatim reference, so the reliable UnitBehaviorAdd-with-count
         primitive is used instead. Lives on the sieged form only, so stacks reset to 0
         on unsiege and re-grow on re-siege. FLAG: confirm in game that 5 stacks =
         +5 range (standard per-stack additive Modification, but unverified here). -->
    <CBehaviorBuff id="WoLUGraduatingRange">
        <Alignment value="Positive"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoFlags index="Hidden" value="1"/>
        <InfoIcon value="Assets\Textures\btn-upgrade-terran-siegetech.dds"/>
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <MaxStackCount value="5"/>
        <Modification WeaponRange="1"/>
    </CBehaviorBuff>
</Catalog>
