<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Super Stimpack buff — verbatim clone of Nova Covert Ops "SuperStim"
         (novastoryassets.sc2mod BehaviorData.xml): same 1.5x move/attack speed and
         15 s duration as vanilla Stimpack. Adaptations: icon swapped to the WoL stim
         icon (the NCO texture isn't in Liberty), and the NCO-only Hellion
         remove-validator dropped (SourceIsNotHellion doesn't exist in Liberty). -->
    <CBehaviorBuff id="WoLUSuperStim">
        <Alignment value="Positive"/>
        <InfoIcon value="Assets\Textures\btn-ability-terran-stimpack.dds"/>
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <Duration value="15"/>
        <Modification MoveSpeedMultiplier="1.5" AttackSpeedMultiplier="1.5"/>
    </CBehaviorBuff>

    <!-- Predator Adaptive Defenses (AP). DamageResponse ModifyFraction halves incoming
         damage — schema verified verbatim against the Moebius mod's AdvancedShielding
         (mods/_reference/moebius BehaviorData.xml). SIMPLIFICATION: the table says
         "halves ranged/splash dmg"; the DamageResponse Kind-filter semantics are
         ambiguous in the reference (all Kinds set to 0), so this halves ALL incoming
         damage — slightly stronger, fits an overpowered mod, and avoids guessing the
         filter. Permanent + player-only: attached to player Predators via the periodic
         UnitBehaviorAdd in LibWoLUnbalanced.galaxy (rule 9 safe). -->
    <CBehaviorBuff id="WoLUAdaptiveDefenses">
        <Alignment value="Positive"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoIcon value="Assets\Textures\btn-ability-zeratul-sentry-reflectionshield.dds"/>
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <DamageResponse ModifyFraction="0.5" ModifyMinimumDamage="1">
            <Chance value="1"/>
        </DamageResponse>
    </CBehaviorBuff>

    <!-- Siege Tank Graduating Range (unit-table: sieged range grows +1 every 3 s, up
         to +5). One stack = +1 WeaponRange (Modification field confirmed from liberty
         BunkerWeaponRangeBonus); MaxStackCount caps at +5. The stacking is DRIVEN from
         the galaxy lib (libWoLU_GraduateSiegeRange, every 3 s adds one stack to player
         SiegeTankSieged/SiegeBreakerSieged up to 5) — a self-stacking PeriodicEffect
         buff has no verbatim reference, so the reliable UnitBehaviorAdd-with-count
         primitive is used instead. Lives on the sieged form only, so stacks reset to 0
         on unsiege and re-grow on re-siege. FLAG: confirm in game that 5 stacks =
         +5 range (standard per-stack additive Modification, but unverified here). -->
    <CBehaviorBuff id="WoLUGraduatingRange">
        <Alignment value="Positive"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoFlags index="Hidden" value="1"/>
        <InfoIcon value="Assets\Textures\btn-upgrade-terran-siegetech.dds"/>
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <MaxStackCount value="5"/>
        <Modification WeaponRange="1"/>
    </CBehaviorBuff>

    <!-- Senior Ghost merc: +50% damage dealt (the "1.5x dmg" part — Life/Energy/regen are
         scaled via genlib Multiply 1.5; armor is flat in the clone). DamageDealtFraction is
         an ADDITIVE, per-damage-Kind INDEXED array (CONFIRMED: liberty's DoubleDamage =
         DamageDealtFraction index="Ranged" value="1" => x2; default 0 => x1). The earlier
         scalar <Modification DamageDealtFraction="0.5"/> had no Kind index and didn't apply.
         Innate + hidden, on the MercSeniorGhost clone only (player-exclusive).
         The RANGED fraction was REMOVED and BAKED into the rifle weapon-effect clone
         C10CanisterRifleWoLU (EffectData/WeaponData/UnitData) instead, so the damage panel
         reads the real fired number (30 / +15 Light) — keeping it here too would DOUBLE-COUNT
         the rifle. Spell stays (so Snipe — SnipeWoLU → SnipeDamage, Kind=Spell — keeps its
         +50%); Melee/Splash are harmless (the ghost has no melee/splash attack) but preserve
         the "1.5x damage" theme for any inherited ability. -->
    <CBehaviorBuff id="WoLUSeniorGhostBoost">
        <Alignment value="Positive"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoFlags index="Hidden" value="1"/>
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <Modification>
            <DamageDealtFraction index="Spell" value="0.5"/>
            <DamageDealtFraction index="Melee" value="0.5"/>
            <DamageDealtFraction index="Splash" value="0.5"/>
        </Modification>
    </CBehaviorBuff>

    <!-- (WoLULiberatorUpgrades removed with the Midnight Riders merc.) -->

    <!-- Optical Flare (AP Medic): blind an enemy — sight collapses to ~1 (SightBonus form
         from liberty's SightReduction) and it can no longer detect cloak/burrow
         (StateFlags SuppressDetection, form from liberty's Salvage Modification). Negative
         alignment, 15 s. -->
    <CBehaviorBuff id="OpticalFlareBlindWoLU">
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <Alignment value="Negative"/>
        <InfoIcon value="Assets\Textures\btn-ability-zerg-blindingcloud.dds"/>
        <Duration value="15"/>
        <Modification SightBonus="-9">
            <StateFlags index="SuppressDetection" value="1"/>
        </Modification>
    </CBehaviorBuff>

    <!-- Wraith Trigger Override (AP): each attack adds +10% attack speed, stacking up to 10
         (~x2.6 at cap — funnily overpowered). Pattern = Moebius BarrelAccelerator (a stacking
         AttackSpeedMultiplier buff applied on-fire by a weapon effect set). AttackSpeedMultiplier
         confirmed from vanilla Stimpack (value>1 = faster). Decays after 4 s of not attacking. -->
    <CBehaviorBuff id="WoLUWraithTriggerOverride">
        <Alignment value="Positive"/>
        <InfoFlags index="Hidden" value="1"/>
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <MaxStackCount value="10"/>
        <Duration value="4"/>
        <Modification AttackSpeedMultiplier="1.1"/>
    </CBehaviorBuff>

    <!-- Jotun (MercThor) Immortality Protocol — make it RESURRECT AS ITSELF (owner reversed the
         v0.3.7 strip). The base Thor's death-response `ThorDontDie` (DamageResponse Fatal=1 ->
         Handled="ThorWreckage", gated on the auto-granted UseMechanicalRebirth upgrade) morphs the
         dying unit into the `ThorWreckage` UNIT, whose `ThorReborn` morph rebuilds a *base Thor*
         (its InfoArray Unit="Thor") AND charges the base Thor's 200-gas cost -> the "costs gas"
         tooltip + a two-HP-bar base-Thor identity over the merc actor. To revive as the Jotun
         instead, build a PARALLEL merc-exclusive chain (this behavior + MercThorWreckage unit +
         MercThorReborn morph) that points at MercThor with no gas. This clone overrides only the
         wreck target (Handled). DamageResponse is a struct, so re-state the full block (a partial
         override on a struct field doesn't reliably merge) — verbatim from ThorDontDie except
         Handled. MercThor is player-exclusive, so no flag gate is needed; UseMechanicalRebirth is
         already auto-granted by the lib. -->
    <CBehaviorBuff id="MercThorDontDie" parent="ThorDontDie">
        <DamageResponse>
            <Chance value="1"/>
            <Fatal value="1"/>
            <Handled value="MercThorWreckage"/>
            <ModifyFraction value="0"/>
        </DamageResponse>
        <Requirements value="UseMechanicalRebirth"/>
    </CBehaviorBuff>

    <!-- Defensive Matrix ON-DAMAGE auto-trigger (BC / Science Vessel / Jackson's Revenge).
         What:  a permanent hidden buff whose DamageResponse fires the DefensiveMatrixOnDamageSetWoLU
                effect (apply the vanilla DefensiveMatrix shield buff + fill shields) on the DAMAGE
                EVENT — "a cast immediately before/after we receive damage".
         Why:   the OLD design autocast DefensiveMatrixWoLU on the WoLUCasterDamaged validator
                (caster Life < 100% = a STATE), which re-cast every cooldown for as long as the unit
                merely sat below full HP — wrong. A DamageResponse is event-driven: it fires once per
                qualifying hit, not while idle-damaged.
         Where: applied player-only to Battlecruiser + ScienceVessel + DukesRevenge via
                libWoLU_AddBehaviorToType in LibWoLUnbalanced.galaxy (rule 9 — never static-edit the
                shared BC/SV BehaviorArray, that would buff enemies too).
         Pattern: liberty's RetributionField (CBehaviorBuff, Hidden, DamageResponse Chance=1
                Handled=<effect> with <Cost><Cooldown TimeUse=N> and NO ModifyFraction) is the
                CONFIRMED throttled, NON-FATAL damage-response pattern — Handled fires on every
                non-fatal hit, rate-limited by the cooldown, and does NOT absorb (we want the SHIELD
                to absorb, not the response). No Fatal flag (fires on ordinary hits, not just lethal).
         THROTTLE: TimeUse="20" = the DefensiveMatrix buff's own Duration=20, so the shield is not
                re-raised while one is already up; the next hit after it expires re-triggers it.
         [STATIC] wiring (ids resolve, schema matches RetributionField + the repo's WoLUAdaptiveDefenses
         / MercThorDontDie DamageResponses). [GAME] the actual on-damage FIRING and the
         "no re-cast while idle-damaged" behavior — owner confirms in a mission with BC/SV/Jackson's. -->
    <CBehaviorBuff id="WoLUDefMatrixOnDamage">
        <Alignment value="Positive"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoFlags index="Hidden" value="1"/>
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <DamageResponse Chance="1" Handled="DefensiveMatrixOnDamageSetWoLU">
            <Cost>
                <Cooldown TimeUse="20"/>
            </Cost>
        </DamageResponse>
    </CBehaviorBuff>

    <!-- Science Vessel passive AUTO-HEAL AURA (v0.3.24 — REPLACES the abandoned Medivac-beam
         heal transplant, which didn't heal in game on a non-Medivac caster). A permanent hidden
         buff that, every 0.0625 s, fires WoLUSVHealAuraSearch (EffectData.xml) to heal ALL nearby
         friendlies (bio + mech + air, incl. friendly STRUCTURES) +1 Life → ~16 HP/s, FREE. Built
         on the basic life-add primitive (robust), not the fragile heal-beam system. Pattern = our
         own WoLUDefMatrixOnDamage above (permanent hidden runtime-added buff, proven to persist) +
         the CBehaviorBuff periodic SCALARS <Period>/<PeriodicEffect> (NOT the *Array forms —
         those exist only on CEffectCreatePersistent; CBehaviorBuff periodics are scalars, verified
         vs liberty.sc2mod BehaviorData.xml CloakField/ChangelingDisguise). A permanent buff needs
         NO <Duration>. GRANULAR (v0.3.x): Period 0.0625 s × Change 1 = ~16 HP/s — the same rate as
         the old 1.0 s × 15 but in tiny 1-HP steps (16 ticks/s) so units no longer die between big
         1-second heal chunks. Applied player-only to ScienceVessel via libWoLU_AddBehaviorToType
         (LibWoLUnbalanced.galaxy) — enemy SVs never get it (rule 9). -->
    <CBehaviorBuff id="WoLUSVHealAura">
        <Alignment value="Positive"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoFlags index="Hidden" value="1"/>
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <Period value="0.0625"/>
        <PeriodicEffect value="WoLUSVHealAuraSearch"/>
    </CBehaviorBuff>

    <!-- SV heal-GLOW cadence (v0.3.x). The heal itself stays granular (WoLUSVHealAura above:
         Period 0.0625 × Change 1 = ~16 HP/s) so units never die between chunks. The VISUAL pulse
         used to fire on EVERY heal tick (~16/s) = far too busy. This SEPARATE 1.0 s behavior drives
         the glow at a calm once-per-second cadence: every 1.0 s it fires WoLUSVHealAuraGlowPing
         (EffectData) — a search over the SAME friendlies — whose per-target WoLUSVHealAuraGlowMark
         (a zero-change NO-OP marker) raises Effect.WoLUSVHealAuraGlowMark.Start on each healed unit,
         which the pulse actor now binds to. Same structure as WoLUSVHealAura but Period 1.0. Permanent
         + hidden, NO <Duration>. Applied player-only to ScienceVessel via libWoLU_AddBehaviorToType
         (LibWoLUnbalanced.galaxy) — enemy SVs never get it (rule 9). -->
    <CBehaviorBuff id="WoLUSVHealAuraGlow">
        <Alignment value="Positive"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoFlags index="Hidden" value="1"/>
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <Period value="1.0"/>
        <PeriodicEffect value="WoLUSVHealAuraGlowPing"/>
    </CBehaviorBuff>

    <!-- Raven SELF point-defense as a PASSIVE PERIODIC BEHAVIOR (v0.3.x — REPLACES the script-order
         interceptor libWoLU_OnInterceptMissiles, whose UnitIssueOrder queued BEHIND the Raven's move
         order so the nullify never fired WHILE the Raven was move-commanded). A behavior periodic fires
         regardless of the unit's order queue → point-defense works while the Raven moves/attacks. Mirrors
         the Point Defense Drone's own search→nullify and our WoLUSVHealAura pattern. Every 0.0625 s
         (~16x/s — missiles are fast) it fires WoLURavenPDSearch (EffectData), an area enum that applies
         the VANILLA PointDefenseLaserDamage (Hide + NullifyMissile, NO caster-identity validator) to each
         nearby enemy missile → the engine nullifies the missile AND the vanilla blue laser beam
         (CActorBeamSimple PointDefenseDroneAttackBeam, On Effect.PointDefenseLaserDamage.Start; At Caster,
         HostLaunch=_Selectable→HostImpact=_Missile) draws Raven→missile. The behavior's caster is the
         Raven, so the beam binds from the Raven automatically. Permanent + hidden, NO <Duration>. Applied
         player-only to Raven via libWoLU_AddBehaviorToType — enemy Ravens never get it (rule 9). -->
    <CBehaviorBuff id="WoLURavenPointDefense">
        <Alignment value="Positive"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoFlags index="Hidden" value="1"/>
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <Period value="0.0625"/>
        <PeriodicEffect value="WoLURavenPDSearch"/>
    </CBehaviorBuff>

    <!-- Predator Charge (AP): a permanent +120% move-speed buff (the Zealot-charge feel
         without the engine-coupled CAbilAugment, which doesn't link to its buff in data and
         is untested on Terran units). Adapted from Protoss Charging (MoveSpeedMultiplier 2.2);
         made permanent like WoLUAdaptiveDefenses, applied per-player via libWoLU_AddBehaviorToType. -->
    <CBehaviorBuff id="WoLUPredatorCharge">
        <Alignment value="Positive"/>
        <BehaviorFlags index="Permanent" value="1"/>
        <InfoIcon value="Assets\Textures\btn-ability-protoss-charge.dds"/>
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <Modification MoveSpeedMultiplier="2.2"/>
    </CBehaviorBuff>
</Catalog>
