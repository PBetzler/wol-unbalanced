<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Marine Magrail Munitions (AP port). Icon + hotkey copied from Nova Covert Ops'
         MagrailMunitionsGoliath button so it matches the original: icon
         btn-upgrade-terran-magrailmunitions.dds, hotkey U (Button/Hotkey/MagrailWoLU
         in GameHotkeys.txt). -->
    <CButton id="MagrailWoLU">
        <Icon value="Assets\Textures\btn-upgrade-terran-magrailmunitions.dds"/>
    </CButton>

    <!-- Passive upgrade-display buttons: shown on a unit's command card (Type=Passive)
         so the player can see the WoL Unbalanced buffs each unit carries — matching the
         campaign's own pattern (Firebat shows Incinerator Nozzles / Juggernaut Plating).
         Icons referenced by base-CASC path (AP/co-op upgrade icons, present in every
         install). Names/tooltips in GameStrings.txt. -->
    <CButton id="WoLUUpgLaserTargeting">
        <Icon value="Assets\Textures\btn-upgrade-terran-lazertargetingsystem.dds"/>
    </CButton>
    <CButton id="WoLUUpgOptLogistics">
        <Icon value="Assets\Textures\btn-upgrade-terran-optimizedlogistics.dds"/>
    </CButton>
    <CButton id="WoLUUpgInternalTech">
        <Icon value="Assets\Textures\btn-upgrade-terran-internalizedtechmodule.dds"/>
    </CButton>
    <CButton id="WoLUUpgSmartServos">
        <Icon value="Assets\Textures\btn-upgrade-terran-transformationservos.dds"/>
    </CButton>

    <!-- Hire buttons for the extra elite mercs. Icons reuse the base unit card icons by
         CASC path (standard terran unit-icon naming). FLAG: a wrong icon path shows a
         blank button but the calldown still works — cosmetic only. -->
