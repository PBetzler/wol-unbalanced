<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Marker upgrade: granted only to the human player by our library; gates all
         WoLU clone abilities via the WoLUHaveFlag requirement. -->
    <CUpgrade id="WoLUnbalancedFlag">
        <EditorCategories value="Race:Terran"/>
    </CUpgrade>

    <!-- Rule 10: heroes join their base units' armory upgrade effect lists (the campaign
         already lists mercs here — e.g. CombatShield covers Marine AND WarPig; we append
         the heroes). Hero units are player-exclusive, so this is rule-9-safe. -->
    <CUpgrade id="CombatShield">
        <EffectArray Reference="Unit,Raynor01,LifeMax" Value="10"/>
        <EffectArray Reference="Unit,Raynor01,LifeStart" Value="10"/>
        <EffectArray Reference="Unit,RaynorCommando,LifeMax" Value="10"/>
        <EffectArray Reference="Unit,RaynorCommando,LifeStart" Value="10"/>
        <EffectArray Reference="Unit,Raynor,LifeMax" Value="10"/>
        <EffectArray Reference="Unit,Raynor,LifeStart" Value="10"/>
    </CUpgrade>
    <CUpgrade id="FirebatJuggernautPlating">
        <EffectArray Reference="Unit,TychusCommando,LifeArmor" Value="2"/>
        <EffectArray Reference="Unit,TychusChaingun,LifeArmor" Value="2"/>
    </CUpgrade>
    <CUpgrade id="JuggernautPlating">
        <EffectArray Reference="Unit,Swann,LifeArmor" Value="2"/>
    </CUpgrade>
    <CUpgrade id="MarauderLifeBoost">
        <EffectArray Reference="Unit,Swann,LifeMax" Value="25"/>
        <EffectArray Reference="Unit,Swann,LifeStart" Value="25"/>
    </CUpgrade>

    <!-- Regenerative Bio-Steel (Zerg-tree lab research): buff the life-regen rate to
         20/sec = the NCO design (10) x2, per the owner spec. Mechanism notes:
         * This CUpgrade is ONLY ever granted to the human player (our library marks the
           research Purchased and re-runs libCamp_gf_TS_ApplyResearchesTech -> Sets
           RegenerativeBioSteel level 1 for the player; enemies never get it). So editing
           its EffectArray Value in static XML is effectively player-only -> rule-9-safe,
           the same class of static CUpgrade extension as CombatShield/MarauderLifeBoost above.
         * The upgrade grant fires on our 1s/10s timers (libWoLU_OnGrantTech), i.e. AFTER
           genlib's MapInit edits, so the upgrade's Operation="Set" is the LAST writer of
           LifeRegenRate for every unit it covers. A per-player genlib CatalogFieldValueModify
           on LifeRegenRate would be overwritten by this Set -> that's why we edit the upgrade
           itself, not the per-player field. (Side note: the existing genlib Vulture
           LifeRegenRate=1 edit is silently overwritten by this upgrade to whatever we Set here
           -> Vulture now lands at 20 too, which is fine. Out of scope to "fix" the genlib edit.)
         * MERGE SEMANTICS: we re-state the COMPLETE vanilla EffectArray with EXPLICIT index=
           on every entry, in vanilla's exact order (indices 0-47). An indexed EffectArray
           entry overrides the SAME array slot in place (proven by libertystory's
           TwinLinkedFlameThrowers <EffectArray index="0" Operation="Set" .../> override) ->
           no duplicate "fighting" entries can exist, the 20 wins unambiguously. The 4
           player-exclusive mechanical units the vanilla list omits (rules 4/10) are appended
           at indices 48-55: Odin (Thor hero), MercThor (Jotun), MercWraith (Winged Nightmares),
           MercHellion (Condor) - all mechanical (LifeArmorName=TerranVehiclePlating / parent of a
           mechanical unit). Bio-steel is mechanical-only, so the bio heroes are correctly absent.
         * LifeRegenDelay kept at vanilla 3.0 (the out-of-combat delay before regen kicks in).
           DEFERRED OPTION: the NCO version regens only in-combat + below-max via DisableValidators;
           we keep the simpler always-on-after-3s mechanism (fine for this OP mod). -->
    <CUpgrade id="RegenerativeBioSteel">
        <EffectArray index="0"  Operation="Set" Reference="Unit,Hellion,LifeRegenDelay"            Value="3.000000"/>
        <EffectArray index="1"  Operation="Set" Reference="Unit,Hellion,LifeRegenRate"             Value="20"/>
        <EffectArray index="2"  Operation="Set" Reference="Unit,SiegeTank,LifeRegenDelay"          Value="3.000000"/>
        <EffectArray index="3"  Operation="Set" Reference="Unit,SiegeTank,LifeRegenRate"           Value="20"/>
