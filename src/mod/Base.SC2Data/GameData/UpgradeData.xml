        <EffectArray index="6"  Operation="Set" Reference="Unit,Thor,LifeRegenDelay"               Value="3.000000"/>
        <EffectArray index="7"  Operation="Set" Reference="Unit,Thor,LifeRegenRate"                Value="20"/>
        <EffectArray index="8"  Operation="Set" Reference="Unit,Diamondback,LifeRegenDelay"        Value="3.000000"/>
        <EffectArray index="9"  Operation="Set" Reference="Unit,Diamondback,LifeRegenRate"         Value="20"/>
        <EffectArray index="10" Operation="Set" Reference="Unit,Vulture,LifeRegenDelay"            Value="3.000000"/>
