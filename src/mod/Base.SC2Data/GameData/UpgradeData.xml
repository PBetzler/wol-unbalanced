        <EffectArray index="19" Operation="Set" Reference="Unit,SiegeBreakerSieged,LifeRegenRate"  Value="20"/>
        <EffectArray index="20" Operation="Set" Reference="Unit,VikingAssault,LifeRegenDelay"      Value="3.000000"/>
