<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Definitions only (rule 9): anything here applies to ALL players, so no direct stat
         edits on player-shared units. Player-scoped changes live in LibWoLUnbalanced.galaxy.
         Hero units are PLAYER-EXCLUSIVE, so giving them base-unit abilities here is safe —
         and necessary: CatalogFieldValueModify cannot create new array entries at runtime. -->

    <!-- Rule 10: bio heroes inherit Stimpack from their base units. Variant per base
         unit: Marine line heals 30 (StimpackWoLU), Firebat/Marauder lines heal 60
         (StimpackMarauderWoLU) — unit-table spec, mirrors NCO's 30/60 split.
         Button cells chosen against each unit's vanilla card (collisions found the
         hard way: RaynorCommando 2,1 = radar, Raynor 2,0-2,3 all taken, Tychus
         2,0/2,1 taken, Firebat 2,0/2,1 taken). -->
    <!-- Explicit indices (= each unit's vanilla array count = next free slot). Index-
         LESS appends do not take effect in our dependency mod; explicit-index appends
         do (proven on Marine). Counts derived from the reference catalogs. -->
    <!-- Rule 10: Raynor (=Marine) inherits Marine abilities — Super Stim AND Magrail
         Munitions. Magrail appended at each variant's next free abil/button index
         (after the stim we added). Button cells picked against each vanilla card. -->
    <CUnit id="Raynor01">
        <AbilArray index="3" Link="StimpackWoLU"/>
        <AbilArray index="4" Link="MagrailWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="5" Face="Stim" Type="AbilCmd" AbilCmd="StimpackWoLU,Execute" Row="2" Column="1"/>
            <LayoutButtons index="6" Face="MagrailWoLU" Type="AbilCmd" AbilCmd="MagrailWoLU,Execute" Row="2" Column="2"/>
            <LayoutButtons index="7"><Face value="CombatShield"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="0"/></LayoutButtons>
            <LayoutButtons index="8"><Face value="WoLUUpgLaserTargeting"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="1"/></LayoutButtons>
        </CardLayouts>
    </CUnit>
    <CUnit id="RaynorCommando">
        <AbilArray index="4" Link="StimpackWoLU"/>
        <AbilArray index="5" Link="MagrailWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="7" Face="Stim" Type="AbilCmd" AbilCmd="StimpackWoLU,Execute" Row="2" Column="2"/>
            <LayoutButtons index="8" Face="MagrailWoLU" Type="AbilCmd" AbilCmd="MagrailWoLU,Execute" Row="2" Column="3"/>
            <LayoutButtons index="9"><Face value="CombatShield"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="0"/></LayoutButtons>
            <LayoutButtons index="10"><Face value="WoLUUpgLaserTargeting"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="1"/></LayoutButtons>
        </CardLayouts>
    </CUnit>
    <CUnit id="Raynor">
        <AbilArray index="7" Link="StimpackWoLU"/>
        <AbilArray index="8" Link="MagrailWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="9" Face="Stim" Type="AbilCmd" AbilCmd="StimpackWoLU,Execute" Row="2" Column="4"/>
            <LayoutButtons index="10" Face="MagrailWoLU" Type="AbilCmd" AbilCmd="MagrailWoLU,Execute" Row="1" Column="0"/>
            <LayoutButtons index="11"><Face value="CombatShield"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="1"/></LayoutButtons>
            <LayoutButtons index="12"><Face value="WoLUUpgLaserTargeting"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="2"/></LayoutButtons>
        </CardLayouts>
    </CUnit>
    <CUnit id="TychusCommando">
        <AbilArray index="4" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="7" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="2" Column="2"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="TychusChaingun">
        <AbilArray index="3" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="5" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="2" Column="1"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="Swann">
        <AbilArray index="4" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="6" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="2" Column="1"/>
        </CardLayouts>
    </CUnit>

    <!-- Vanilla stim users: REPLACE their stim ability/button slots with the WoLU clone by
         index (global — but safe: vanilla stim was requirement-gated and no mission ever
         grants the tech to AI players, and the clone is gated on our flag upgrade which
         only the human player receives). Runtime per-player link swaps proved to be
         silent no-ops, so this must live in XML. -->
    <!-- EXPLICIT-INDEX append test: vanilla Marine has AbilArray 0-3 (stop/attack/
         move/Stimpack) and LayoutButtons 0-5, so Magrail = abil index 4, button
         index 6. If this makes Magrail appear (and diag2 shows acount=5
         m4=MagrailWoLU), index-less appends were the bug and every other unit's
         appends get the same treatment. -->
    <CUnit id="Marine">
        <AbilArray index="3" Link="StimpackWoLU"/>
        <AbilArray index="4" Link="MagrailWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="5" AbilCmd="StimpackWoLU,Execute"/>
            <LayoutButtons index="6" Face="MagrailWoLU" Type="AbilCmd" AbilCmd="MagrailWoLU,Execute" Row="2" Column="1"/>
            <!-- Passive upgrade display (row 1): the WoL Unbalanced stat buffs this unit
                 carries. Type=Passive (no action), gated on WoLUHaveFlag so only the
                 player's units show them. Super Stim + Magrail already show as the
                 action buttons in row 2. Indices continue from the existing buttons. -->
            <LayoutButtons index="7">
                <Face value="CombatShield"/>
                <Type value="Passive"/>
                <AbilCmd value="255"/>
                <Requirements value="WoLUHaveFlag"/>
                <Row value="1"/>
                <Column value="0"/>
            </LayoutButtons>
            <LayoutButtons index="8">
                <Face value="WoLUUpgLaserTargeting"/>
                <Type value="Passive"/>
                <AbilCmd value="255"/>
                <Requirements value="WoLUHaveFlag"/>
                <Row value="1"/>
                <Column value="1"/>
            </LayoutButtons>
            <LayoutButtons index="9">
                <Face value="WoLUUpgOptLogistics"/>
                <Type value="Passive"/>
                <AbilCmd value="255"/>
                <Requirements value="WoLUHaveFlag"/>
                <Row value="1"/>
                <Column value="2"/>
            </LayoutButtons>
        </CardLayouts>
    </CUnit>
    <!-- Marauder stim: the campaign REMOVES the vanilla StimpackMarauder ability
         (AbilArray index 3 removed="1") and replaces its stim button (index 6) with the
         AblativeScales passive. Our AbilArray index-3 override re-adds the ability (merge
         verified). The OLD button override only set AbilCmd on index 6 — that's the
         AblativeScales PASSIVE button, so it stayed Type=Passive/Face=AblativeScales and
         never worked as stim (the bug). Fix: leave AblativeScales alone and APPEND a real
         stim button at the next free index (10) in a free cell (2,0). -->
    <CUnit id="Marauder">
        <AbilArray index="3" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="7"><Face value="JuggernautPlating"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="0"/></LayoutButtons>
            <LayoutButtons index="8"><Face value="WoLUUpgLaserTargeting"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="1"/></LayoutButtons>
            <LayoutButtons index="9"><Face value="WoLUUpgInternalTech"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="2"/></LayoutButtons>
            <LayoutButtons index="10" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="2" Column="0"/>
        </CardLayouts>
    </CUnit>
    <!-- Rule 4: War Pigs (Marine merc) inherit Marine upgrades — stim (index-override
         of vanilla slot) + Magrail Munitions (appended at next free abil 4 / button 7,
         free cell 2,2). +1 range / +2 sight (Laser Targeting) applied in genlib. -->
    <CUnit id="WarPig">
        <AbilArray index="3" Link="StimpackWoLU"/>
        <AbilArray index="4" Link="MagrailWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="5" AbilCmd="StimpackWoLU,Execute"/>
            <LayoutButtons index="7" Face="MagrailWoLU" Type="AbilCmd" AbilCmd="MagrailWoLU,Execute" Row="2" Column="2"/>
            <LayoutButtons index="8"><Face value="CombatShield"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="0"/></LayoutButtons>
            <LayoutButtons index="9"><Face value="WoLUUpgLaserTargeting"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="1"/></LayoutButtons>
        </CardLayouts>
    </CUnit>
    <CUnit id="HammerSecurity">
        <AbilArray index="3" Link="StimpackMarauderWoLU"/>
    </CUnit>

    <!-- Thor ground splash is now wired by overriding the vanilla ThorsHammer weapon's
         Effect (WeaponData.xml) — NOT by a weapon clone/swap, which broke the attack
         animation (actors bind to WeaponStart.ThorsHammer). No Thor WeaponArray edit
         needed here anymore. -->

    <!-- AP port: Firebats get Stimpack (vanilla campaign firebats have none); the 60-heal
         marauder variant per the unit-table. The button is gated on WoLUHaveFlag, which
         enemy players never receive. Cell 2,2 — vanilla card has passive-display
         buttons at 2,0 (Incinerator Nozzles) and 2,1 (Juggernaut Plating). -->
    <CUnit id="Firebat">
        <AbilArray index="3" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="7" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="2" Column="2"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="DevilDog">
        <AbilArray index="3" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="7" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="2" Column="2"/>
        </CardLayouts>
    </CUnit>

    <!-- Super Stimpack rollout per the unit-table Comments. Heal amount tracks HP:
         units with MORE life than a Marine (65 after our +20) use the 60-heal marauder
         set so the heal stays proportional — Reaper (70), Ghost/Spectre (100), Hellion.
         Marine + Raynor variants keep the 30-heal Marine set. (open-issues: stim-60.) -->
    <CUnit id="Reaper">
        <AbilArray index="3" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="6" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="2" Column="1"/>
            <LayoutButtons index="7"><Face value="WoLUUpgLaserTargeting"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="0"/></LayoutButtons>
        </CardLayouts>
    </CUnit>
    <CUnit id="Hellion">
        <AbilArray index="3" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="5" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="2" Column="0"/>
            <LayoutButtons index="6"><Face value="WoLUUpgOptLogistics"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="0"/></LayoutButtons>
            <LayoutButtons index="7"><Face value="WoLUUpgSmartServos"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="1"/></LayoutButtons>
        </CardLayouts>
    </CUnit>

    <!-- Ghost/Spectre autocast kit. New ABILITIES are appended (never index-overridden:
         enemy ghosts/spectres actively use vanilla Snipe/Obliterate — replacing their
         ability slots would change enemy behavior, rule 9). The vanilla BUTTONS are
         index-overridden to point at the clones instead: cards are pure UI, the AI
         never reads them, so this is enemy-safe — and it costs no card space.
         Ghost buttons (liberty.sc2mod order): [7]=Snipe, [11]=EMP.
         Spectre buttons (liberty.sc2campaign order): [12]=Obliterate. -->
    <CUnit id="Ghost">
        <AbilArray index="9" Link="StimpackMarauderWoLU"/>
        <AbilArray index="10" Link="SnipeWoLU"/>
        <AbilArray index="11" Link="EMPWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="7" AbilCmd="SnipeWoLU,Execute"/>
            <LayoutButtons index="11" AbilCmd="EMPWoLU,Execute"/>
            <LayoutButtons index="13" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="1" Column="1"/>
            <LayoutButtons index="14"><Face value="WoLUUpgLaserTargeting"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="4"/></LayoutButtons>
        </CardLayouts>
    </CUnit>
    <CUnit id="Spectre">
        <AbilArray index="9" Link="StimpackMarauderWoLU"/>
        <AbilArray index="10" Link="ObliterateWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="12" AbilCmd="ObliterateWoLU,Execute"/>
            <LayoutButtons index="14" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="1" Column="0"/>
            <LayoutButtons index="15"><Face value="WoLUUpgLaserTargeting"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="4"/></LayoutButtons>
        </CardLayouts>
    </CUnit>

    <!-- (Marine Magrail Munitions lives in the Marine block above — autocast bonus
         shot, 20 dmg, 10 s cooldown, button at the free cell 2,1.) -->

    <!-- Battlecruiser autocast kit appended (append-don't-override; clones gated on
         WoLUHaveFlag so enemy BCs can't use them). Base BC card has only Yamato at
         2,0, so 2,1/2,2/2,3 are free. The clone buttons carry the autocast circle;
         vanilla manual Yamato at 2,0 stays. attack-while-moving + ignore-armor are
         applied per player on the laser weapons/effects in genlib. -->
    <CUnit id="Battlecruiser">
        <AbilArray index="5" Link="MissilePodsWoLU"/>
        <AbilArray index="6" Link="DefensiveMatrixWoLU"/>
        <AbilArray index="7" Link="YamatoWoLU"/>
        <AbilArray index="8" Link="TacticalJumpWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="6" Face="MissilePods" Type="AbilCmd" AbilCmd="MissilePodsWoLU,Execute" Row="2" Column="1"/>
            <LayoutButtons index="7" Face="DefensiveMatrix" Type="AbilCmd" AbilCmd="DefensiveMatrixWoLU,Execute" Row="2" Column="2"/>
            <LayoutButtons index="8" Face="YamatoGun" Type="AbilCmd" AbilCmd="YamatoWoLU,Execute" Row="2" Column="3"/>
            <LayoutButtons index="11" Face="TacticalJumpWoLU" Type="AbilCmd" AbilCmd="TacticalJumpWoLU,Execute" Requirements="WoLUHaveFlag" Row="1" Column="2"/>
            <!-- BC has Internal Tech Module + Optimized Logistics (NOT Laser Targeting —
                 its targeting upgrade is Field-Assist, a range aura). -->
            <LayoutButtons index="9">
                <Face value="WoLUUpgInternalTech"/><Type value="Passive"/><AbilCmd value="255"/>
                <Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="0"/>
            </LayoutButtons>
            <LayoutButtons index="10">
                <Face value="WoLUUpgOptLogistics"/><Type value="Passive"/><AbilCmd value="255"/>
                <Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="1"/>
            </LayoutButtons>
        </CardLayouts>
    </CUnit>

    <!-- Jackson's Revenge (DukesRevenge) = the BC hero. It already has its own three
         actives (DukesRevengeYamato/MissilePods/DefensiveMatrix at abils 3/4/5, buttons
         5/6/7) but they never autocast (issue 5). Append autocast clones and re-point the
         three buttons to them (player-exclusive hero → rule-9 safe). The attack-side buffs
         (fire-while-moving + ignore-armor, applied per-player in genlib on the DR weapons/
         effects) weren't visible — add a "fire while moving" passive display so the attack
         upgrades show alongside the movement/armor boosts the user already saw. -->
    <CUnit id="DukesRevenge">
        <AbilArray index="6" Link="DukesRevengeYamatoWoLU"/>
        <AbilArray index="7" Link="DukesRevengeMissilePodsWoLU"/>
        <AbilArray index="8" Link="DukesRevengeDefensiveMatrixWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="5" AbilCmd="DukesRevengeYamatoWoLU,Execute"/>
            <LayoutButtons index="6" AbilCmd="DukesRevengeMissilePodsWoLU,Execute"/>
            <LayoutButtons index="7" AbilCmd="DukesRevengeDefensiveMatrixWoLU,Execute"/>
            <LayoutButtons index="8"><Face value="WoLUUpgSmartServos"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="0"/></LayoutButtons>
            <LayoutButtons index="9"><Face value="WoLUUpgInternalTech"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="1"/></LayoutButtons>
        </CardLayouts>
    </CUnit>

    <!-- Science Vessel: AP list includes Defensive Matrix — reuse the BC clone
         (same append + WoLUHaveFlag gate). Free card cell 2,2 (vanilla SV uses
         2,0 NanoRepair / 2,1 Irradiate / 2,3 Detector). -->
    <CUnit id="ScienceVessel">
        <AbilArray index="4" Link="DefensiveMatrixWoLU"/>
        <AbilArray index="5" Link="TacticalJumpWoLU"/>
        <AbilArray index="6" Link="NanoRepairWoLU"/>
        <AbilArray index="7" Link="EMPShockwaveWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="9" Face="DefensiveMatrix" Type="AbilCmd" AbilCmd="DefensiveMatrixWoLU,Execute" Row="2" Column="2"/>
            <LayoutButtons index="10" Face="TacticalJumpWoLU" Type="AbilCmd" AbilCmd="TacticalJumpWoLU,Execute" Requirements="WoLUHaveFlag" Row="1" Column="0"/>
            <LayoutButtons index="11" Face="NanoRepair" Type="AbilCmd" AbilCmd="NanoRepairWoLU,Execute" Requirements="WoLUHaveFlag" Row="1" Column="1"/>
            <LayoutButtons index="12" Face="EMP" Type="AbilCmd" AbilCmd="EMPShockwaveWoLU,Execute" Requirements="WoLUHaveFlag" Row="1" Column="2"/>
        </CardLayouts>
    </CUnit>

    <!-- Tactical Jump (AP) appended to Hercules + Predator. Vanilla counts: Hercules
         AbilArray 3 / LayoutButtons 8 (append 3 / 8, free cell R2C2); Predator AbilArray 3 /
         LayoutButtons 7 (append 3 / 7, free cell R2C1). Button gated WoLUHaveFlag. -->
    <CUnit id="Hercules">
        <AbilArray index="3" Link="TacticalJumpWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="8" Face="TacticalJumpWoLU" Type="AbilCmd" AbilCmd="TacticalJumpWoLU,Execute" Requirements="WoLUHaveFlag" Row="2" Column="2"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="Predator">
        <AbilArray index="3" Link="TacticalJumpWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="7" Face="TacticalJumpWoLU" Type="AbilCmd" AbilCmd="TacticalJumpWoLU,Execute" Requirements="WoLUHaveFlag" Row="2" Column="1"/>
        </CardLayouts>
    </CUnit>

    <!-- AP Medic kit: Restoration (ally debuff-cleanse) + Optical Flare (enemy blind).
         Appended (enemy-invisible cards). Medic vanilla AbilArray 4 / LayoutButtons 9 →
         appends 4,5 / 9,10; free card cells R2C3, R2C4. -->
    <CUnit id="Medic">
        <AbilArray index="4" Link="RestorationWoLU"/>
        <AbilArray index="5" Link="OpticalFlareWoLU"/>
        <AbilArray index="6" Link="HealWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="9" Face="RestorationWoLU" Type="AbilCmd" AbilCmd="RestorationWoLU,Execute" Row="2" Column="3"/>
            <LayoutButtons index="10" Face="OpticalFlareWoLU" Type="AbilCmd" AbilCmd="OpticalFlareWoLU,Execute" Row="2" Column="4"/>
            <!-- Adaptive Medpacks: mechanical+air heal (autocast). Vanilla heal button stays
                 at 2,0; this one (1,0) covers mechanical/air. -->
            <LayoutButtons index="11" Face="MedicHeal" Type="AbilCmd" AbilCmd="HealWoLU,Execute" Row="1" Column="0"/>
        </CardLayouts>
    </CUnit>
    <!-- Rule 10 hero parity: Stetmann (=Medic) gets the same kit. Stetmann has a different
         base kit (no `heal`), so it doesn't inherit the Medic appends — replicate them.
         Stetmann vanilla AbilArray 3 / LayoutButtons 8 → appends 3,4 / 8,9; free R2C2, R2C3. -->
    <CUnit id="Stetmann">
        <AbilArray index="3" Link="RestorationWoLU"/>
        <AbilArray index="4" Link="OpticalFlareWoLU"/>
        <AbilArray index="5" Link="HealWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="8" Face="RestorationWoLU" Type="AbilCmd" AbilCmd="RestorationWoLU,Execute" Row="2" Column="2"/>
            <LayoutButtons index="9" Face="OpticalFlareWoLU" Type="AbilCmd" AbilCmd="OpticalFlareWoLU,Execute" Row="2" Column="3"/>
            <LayoutButtons index="10" Face="MedicHeal" Type="AbilCmd" AbilCmd="HealWoLU,Execute" Row="1" Column="0"/>
        </CardLayouts>
    </CUnit>

    <!-- Command Center OP economy (user request): the player's CC gets free, unlimited
         Calldown: MULE + Extra Supplies (CalldownMULEWoLU / SupplyDropWoLU, defined in
         AbilData — energy-free, no Orbital requirement, button gated WoLUHaveFlag). The
         merged campaign CC has 10 abils (0-9) and 14 card buttons (0-13), so the abilities
         append at 10/11 and the buttons at 14/15, placed in the free top-row cells (0,1 /
         0,2). Static XML is global but the WoLUHaveFlag gate + free-cost clones keep enemy
         CCs vanilla (rule 9); the lib also TechTreeUnitAllow's the MULE unit. -->
    <CUnit id="CommandCenter">
        <AbilArray index="10" Link="CalldownMULEWoLU"/>
        <AbilArray index="11" Link="SupplyDropWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="14" Face="CalldownMULE" Type="AbilCmd" AbilCmd="CalldownMULEWoLU,Execute" Row="0" Column="1"/>
            <LayoutButtons index="15" Face="SupplyDrop" Type="AbilCmd" AbilCmd="SupplyDropWoLU,Execute" Row="0" Column="2"/>
        </CardLayouts>
    </CUnit>

    <!-- Passive upgrade-display rows for units we hadn't given a card block yet.
         Type=Passive icons in the free row 1, gated on WoLUHaveFlag, explicit indices
         = each unit's vanilla button count (append rule). Shows the WoL buffs whose
         upgrade has a reusable icon (campaign buttons by id + our AP icon set); buffs
         that are abilities already show as their action buttons. -->
    <!-- Goliath has NO Laser Targeting (its AP list omits it): show Shaped Hull +
         Optimized Logistics (its real upgrades). -->
    <CUnit id="Goliath">
        <CardLayouts index="0">
            <LayoutButtons index="7"><Face value="ShapedHull"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="0"/></LayoutButtons>
            <LayoutButtons index="8"><Face value="WoLUUpgOptLogistics"/><Type value="Passive"/><AbilCmd value="255"/><Requirements value="WoLUHaveFlag"/><Row value="1"/><Column value="1"/></LayoutButtons>
        </CardLayouts>
    </CUnit>
    <!-- Spartan Company (Goliath merc) is a SEPARATE unit, not a Goliath clone, so it never
         inherited Goliath's WoL upgrade displays (issue 12). It already shows its vanilla
         passives (MultiLock @2,0 / Ares-Class @2,1, buttons 5-6); append the same WoL
         passives the Goliath shows in the free row-1 cells. The stat parity (Ares-Class
         range +3/+1, Shaped Hull +25) is applied per-player in genlib on SpartanCompany* . -->
    <CUnit id="SpartanCompany">
