<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Definitions only (rule 9): anything here applies to ALL players, so no direct stat
         edits on player-shared units. Player-scoped changes live in LibWoLUnbalanced.galaxy.
         Hero units are PLAYER-EXCLUSIVE, so giving them base-unit abilities here is safe —
         and necessary: CatalogFieldValueModify cannot create new array entries at runtime. -->

    <!-- Rule 10: bio heroes inherit Stimpack from their base units. Variant per base
         unit: Marine line heals 30 (StimpackWoLU), Firebat/Marauder lines heal 60
         (StimpackMarauderWoLU) — unit-table spec, mirrors NCO's 30/60 split.
         Button cells chosen against each unit's vanilla card (collisions found the
         hard way: RaynorCommando 2,1 = radar, Raynor 2,0-2,3 all taken, Tychus
         2,0/2,1 taken, Firebat 2,0/2,1 taken). -->
    <!-- Explicit indices (= each unit's vanilla array count = next free slot). Index-
         LESS appends do not take effect in our dependency mod; explicit-index appends
         do (proven on Marine). Counts derived from the reference catalogs. -->
    <CUnit id="Raynor01">
        <AbilArray index="3" Link="StimpackWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="5" Face="Stim" Type="AbilCmd" AbilCmd="StimpackWoLU,Execute" Row="2" Column="1"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="RaynorCommando">
        <AbilArray index="4" Link="StimpackWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="7" Face="Stim" Type="AbilCmd" AbilCmd="StimpackWoLU,Execute" Row="2" Column="2"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="Raynor">
        <AbilArray index="7" Link="StimpackWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="9" Face="Stim" Type="AbilCmd" AbilCmd="StimpackWoLU,Execute" Row="2" Column="4"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="TychusCommando">
        <AbilArray index="4" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="7" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="2" Column="2"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="TychusChaingun">
        <AbilArray index="3" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="5" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="2" Column="1"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="Swann">
        <AbilArray index="4" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="6" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="2" Column="1"/>
        </CardLayouts>
    </CUnit>

    <!-- Vanilla stim users: REPLACE their stim ability/button slots with the WoLU clone by
         index (global — but safe: vanilla stim was requirement-gated and no mission ever
         grants the tech to AI players, and the clone is gated on our flag upgrade which
         only the human player receives). Runtime per-player link swaps proved to be
         silent no-ops, so this must live in XML. -->
    <!-- EXPLICIT-INDEX append test: vanilla Marine has AbilArray 0-3 (stop/attack/
         move/Stimpack) and LayoutButtons 0-5, so Magrail = abil index 4, button
         index 6. If this makes Magrail appear (and diag2 shows acount=5
         m4=MagrailWoLU), index-less appends were the bug and every other unit's
         appends get the same treatment. -->
    <CUnit id="Marine">
        <AbilArray index="3" Link="StimpackWoLU"/>
        <AbilArray index="4" Link="MagrailWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="5" AbilCmd="StimpackWoLU,Execute"/>
            <LayoutButtons index="6" Face="MagrailWoLU" Type="AbilCmd" AbilCmd="MagrailWoLU,Execute" Row="2" Column="1"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="Marauder">
        <AbilArray index="3" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="6" AbilCmd="StimpackMarauderWoLU,Execute"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="WarPig">
        <AbilArray index="3" Link="StimpackWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="5" AbilCmd="StimpackWoLU,Execute"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="HammerSecurity">
        <AbilArray index="3" Link="StimpackMarauderWoLU"/>
    </CUnit>

    <!-- Thor ground splash: weapon slot 1 (0 = Javelin AA) -> the WoLU clone. Global,
         but the clone is stat-identical to vanilla and its effect set is player-gated
         (Shaped Blast pattern) — enemy Thors deal exact vanilla damage. -->
    <CUnit id="Thor">
        <WeaponArray index="1" Link="ThorsHammerWoLU"/>
    </CUnit>

    <!-- AP port: Firebats get Stimpack (vanilla campaign firebats have none); the 60-heal
         marauder variant per the unit-table. The button is gated on WoLUHaveFlag, which
         enemy players never receive. Cell 2,2 — vanilla card has passive-display
         buttons at 2,0 (Incinerator Nozzles) and 2,1 (Juggernaut Plating). -->
    <CUnit id="Firebat">
        <AbilArray index="3" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="7" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="2" Column="2"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="DevilDog">
        <AbilArray index="3" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="7" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="2" Column="2"/>
        </CardLayouts>
    </CUnit>

    <!-- Super Stimpack rollout per the unit-table Comments: Reaper (heal 30, "add super
         stim and cloak"), Ghost/Spectre (heal 30, part of their autocast kit), Hellion
         (heal 60 — NCO gives the Hellbat line the 60-heal marauder set). -->
    <CUnit id="Reaper">
        <AbilArray index="3" Link="StimpackWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="6" Face="Stim" Type="AbilCmd" AbilCmd="StimpackWoLU,Execute" Row="2" Column="1"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="Hellion">
        <AbilArray index="3" Link="StimpackMarauderWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="5" Face="Stim" Type="AbilCmd" AbilCmd="StimpackMarauderWoLU,Execute" Row="2" Column="0"/>
        </CardLayouts>
    </CUnit>

    <!-- Ghost/Spectre autocast kit. New ABILITIES are appended (never index-overridden:
         enemy ghosts/spectres actively use vanilla Snipe/Obliterate — replacing their
         ability slots would change enemy behavior, rule 9). The vanilla BUTTONS are
         index-overridden to point at the clones instead: cards are pure UI, the AI
         never reads them, so this is enemy-safe — and it costs no card space.
         Ghost buttons (liberty.sc2mod order): [7]=Snipe, [11]=EMP.
         Spectre buttons (liberty.sc2campaign order): [12]=Obliterate. -->
    <CUnit id="Ghost">
        <AbilArray index="9" Link="StimpackWoLU"/>
        <AbilArray index="10" Link="SnipeWoLU"/>
        <AbilArray index="11" Link="EMPWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="7" AbilCmd="SnipeWoLU,Execute"/>
            <LayoutButtons index="11" AbilCmd="EMPWoLU,Execute"/>
            <LayoutButtons index="13" Face="Stim" Type="AbilCmd" AbilCmd="StimpackWoLU,Execute" Row="1" Column="1"/>
        </CardLayouts>
    </CUnit>
    <CUnit id="Spectre">
        <AbilArray index="9" Link="StimpackWoLU"/>
        <AbilArray index="10" Link="ObliterateWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="12" AbilCmd="ObliterateWoLU,Execute"/>
            <LayoutButtons index="14" Face="Stim" Type="AbilCmd" AbilCmd="StimpackWoLU,Execute" Row="1" Column="0"/>
        </CardLayouts>
    </CUnit>

    <!-- (Marine Magrail Munitions lives in the Marine block above — autocast bonus
         shot, 20 dmg, 10 s cooldown, button at the free cell 2,1.) -->

    <!-- Battlecruiser autocast kit appended (append-don't-override; clones gated on
         WoLUHaveFlag so enemy BCs can't use them). Base BC card has only Yamato at
         2,0, so 2,1/2,2/2,3 are free. The clone buttons carry the autocast circle;
         vanilla manual Yamato at 2,0 stays. attack-while-moving + ignore-armor are
         applied per player on the laser weapons/effects in genlib. -->
    <CUnit id="Battlecruiser">
        <AbilArray index="5" Link="MissilePodsWoLU"/>
        <AbilArray index="6" Link="DefensiveMatrixWoLU"/>
        <AbilArray index="7" Link="YamatoWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="6" Face="MissilePods" Type="AbilCmd" AbilCmd="MissilePodsWoLU,Execute" Row="2" Column="1"/>
            <LayoutButtons index="7" Face="DefensiveMatrix" Type="AbilCmd" AbilCmd="DefensiveMatrixWoLU,Execute" Row="2" Column="2"/>
            <LayoutButtons index="8" Face="YamatoGun" Type="AbilCmd" AbilCmd="YamatoWoLU,Execute" Row="2" Column="3"/>
        </CardLayouts>
    </CUnit>

    <!-- Science Vessel: AP list includes Defensive Matrix — reuse the BC clone
         (same append + WoLUHaveFlag gate). Free card cell 2,2 (vanilla SV uses
         2,0 NanoRepair / 2,1 Irradiate / 2,3 Detector). -->
    <CUnit id="ScienceVessel">
        <AbilArray index="4" Link="DefensiveMatrixWoLU"/>
        <CardLayouts index="0">
            <LayoutButtons index="9" Face="DefensiveMatrix" Type="AbilCmd" AbilCmd="DefensiveMatrixWoLU,Execute" Row="2" Column="2"/>
        </CardLayouts>
    </CUnit>
</Catalog>
