<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Super Stimpack effect chain — verbatim clone of NCO SuperStimpackMarine /
         SuperStimpackMarauderHellbat chains (novastoryassets.sc2mod EffectData.xml),
         ids renamed: CEffectSet -> apply WoLUSuperStim buff + CEffectModifyUnit heal.
         Heal 30 for the Marine line, 60 for Marauder/Firebat lines (unit-table spec,
         matches NCO's 30/60 split). Schema notes vs the failed first attempt: the
         heal must be the ATTRIBUTE form (VitalArray ... Change="..."), and both
         effects target Source, not Caster. -->
    <CEffectApplyBehavior id="WoLUStimApply">
        <EditorCategories value="Race:Terran"/>
        <Behavior value="WoLUSuperStim"/>
        <WhichUnit Value="Source"/>
    </CEffectApplyBehavior>
    <CEffectSet id="WoLUStimSet">
        <EditorCategories value="Race:Terran"/>
        <EffectArray value="WoLUStimApply"/>
        <EffectArray value="WoLUStimSetMU"/>
    </CEffectSet>
    <CEffectModifyUnit id="WoLUStimSetMU">
        <EditorCategories value="Race:Terran"/>
        <VitalArray index="Life" Change="30"/>
        <ImpactUnit Value="Source"/>
    </CEffectModifyUnit>
    <CEffectSet id="WoLUStimMarauderSet">
        <EditorCategories value="Race:Terran"/>
        <EffectArray value="WoLUStimApply"/>
        <EffectArray value="WoLUStimMarauderSetMU"/>
    </CEffectSet>
    <CEffectModifyUnit id="WoLUStimMarauderSetMU">
        <EditorCategories value="Race:Terran"/>
        <ImpactUnit Value="Source"/>
        <VitalArray index="Life" Change="60"/>
    </CEffectModifyUnit>

    <!-- Thor ground attack with sieged-tank-style splash. The vanilla ThorsHammer
         weapon's Effect is overridden to this set (WeaponData.xml) — keeping the
         weapon id so attack animations still fire.
         TRIGGER-OVERRIDE shape (the proven non-detaching pattern, cf. the Wraith
         WraithGTriggerOverrideSet): member[0] is the UNMODIFIED vanilla effect
         ThorsHammerDamage, so the bare id STILL FIRES for everyone -> the vanilla
         CActorAction id="ThorAttack" (effectAttack="ThorsHammerDamage") keeps matching
         and its ground muzzle (ThorHandGunAttackLaunch) + impact (ThorHandGunAttackImpact)
         are RESTORED for every Thor (player AND enemy). The vanilla member also deals the
         enemy's exact vanilla damage (rule-9-neutral). member[1] is the player-only
         WoLUHasFlag-gated splash clone (added damage/splash for us). NB: the player's
         primary target therefore takes BOTH the vanilla base hit AND the splash clone
         (~a partial double on the primary) — ACCEPTED (balance is a non-goal; the mod is
         "funnily overpowered"). This REPLACES the earlier action-clone re-bind approach
         (ThorAttack{Vanilla,}WoLU in ActorData.xml), which did NOT re-bind in-game
         (shipped v0.3.11->0.3.30, owner still saw no muzzle/impact). -->
    <CEffectSet id="ThorsHammerWoLUSet">
        <EffectArray value="ThorsHammerDamage"/>
        <EffectArray value="ThorsHammerDamageWoLU"/>
    </CEffectSet>
    <CEffectDamage id="ThorsHammerDamageWoLU" parent="ThorsHammerDamage">
        <ValidatorArray value="WoLUHasFlag"/>
        <Kind value="Splash"/>
        <KindSplash value="Splash"/>
        <!-- Enemy-only splash (same filter pattern as the campaign's Crucio enemy
             damage): never hits own/allied/neutral units. -->
        <SearchFilters value="Ground;Self,Player,Ally,Neutral,Missile,Stasis,Dead,Hidden,Invulnerable"/>
        <!-- Splash radius doubled (user request): 0.8/1.25 -> 1.6/2.5. -->
        <AreaArray Radius="1.6" Fraction="1"/>
        <AreaArray Radius="2.5" Fraction="0.5"/>
    </CEffectDamage>

    <!-- #8: Jotun/Thor AA splash >= the ground weapon's radius. The AA weapon
         (JavelinMissileLaunchers) impacts JavelinMissileLaunchersDamage, whose AreaArray
         radius is only 0.5 (ground ThorsHammer = 1.6/2.5). AreaArray is an INDEXED field
         (per-player CatalogFieldValueModify is a no-op — same class as the unresolved
         AttributeBonus[Light] flatten), so this uses the established Shaped-Blast clone
         pattern (cf. ThorsHammerWoLUSet): override the AA missile's ImpactEffect to a set.
         TRIGGER-OVERRIDE shape: member[0] is the UNMODIFIED vanilla effect
         JavelinMissileLaunchersDamage, so the bare id STILL impacts for everyone -> the
         vanilla CActorAction id="ThorAAAttack" (effectImpact="JavelinMissileLaunchersDamage")
         keeps matching and its AA impact sound (Thor_AntiAirAttackImpact) is RESTORED for
         every Thor (player AND enemy); the vanilla member also deals the enemy's exact
         vanilla AA damage (rule-9-neutral). member[1] is the player-only WoLUHasFlag buffed
         splash clone. The missile VISUAL binds to the LM's AmmoUnit (ThorAAWeapon), not the
         impact effect, so re-pointing ImpactEffect was always keeping the rocket trail; the
         launch sound rides effectLaunch (un-rerouted). NB the player's primary air target
         takes BOTH the vanilla base AA hit AND the buffed splash clone — ACCEPTED (on-theme
         overpowered). This REPLACES the earlier action-clone re-bind (ThorAAAttack{Vanilla,}WoLU),
         which did NOT re-bind in-game. -->
    <CEffectLaunchMissile id="JavelinMissileLaunchersLM">
        <ImpactEffect value="JavelinMissileLaunchersDamageWoLUSet"/>
    </CEffectLaunchMissile>
    <CEffectSet id="JavelinMissileLaunchersDamageWoLUSet">
        <EditorCategories value="Race:Terran"/>
        <EffectArray value="JavelinMissileLaunchersDamage"/>
        <EffectArray value="JavelinMissileLaunchersDamageBuffedWoLU"/>
    </CEffectSet>
    <!-- Player branch: 35/rocket flat (HIP floor, no light bonus) + splash matching the
         ground weapon (1.6/2.5). Air-plane enemy-only SearchFilters (Crucio pattern), so
         the AA splash never friendly-fires our own air units. -->
    <CEffectDamage id="JavelinMissileLaunchersDamageBuffedWoLU" parent="JavelinMissileLaunchersDamage">
        <ValidatorArray value="WoLUHasFlag"/>
        <Amount value="35"/>
        <AttributeBonus index="Light" value="0"/>
        <SearchFilters value="Air;Self,Player,Ally,Neutral,Missile,Stasis,Dead,Hidden,Invulnerable"/>
        <AreaArray Radius="1.6" Fraction="1"/>
        <AreaArray Radius="2.5" Fraction="0.5"/>
    </CEffectDamage>

    <!-- Senior Ghost (MercSeniorGhost, player-exclusive) rifle damage clone. The merc deals
         +50% rifle damage via the WoLUSeniorGhostBoost behavior (DamageDealtFraction), which
         touches NO displayed field, so the unit-info damage panel under-showed the real number.
         Bake the +50% directly into this MercSeniorGhost-only weapon-effect clone instead, and
         REMOVE the Ranged fraction from the boost behavior (BehaviorData.xml) so it isn't double-
         counted. The player's base C10CanisterRifle is 20 (+10 Light) after genlib's Set; ×1.5 =
         30 (+15 Light). parent="C10CanisterRifle" inherits Kind=Ranged etc. Single-shot direct
         damage (no AreaArray) → NOT area damage, so no SearchFilters needed. Fired AND displayed
         by the C10CanisterRifleWoLU weapon (WeaponData.xml), so panel == actual = 30 (CHECK11). -->
    <CEffectDamage id="C10CanisterRifleWoLU" parent="C10CanisterRifle">
        <Amount value="30"/>
        <AttributeBonus index="Light" value="15"/>
    </CEffectDamage>
    <!-- Senior Ghost (MercSeniorGhost, player-exclusive) rifle TRIGGER-OVERRIDE set. Same shape as
         WreckingCrewAssaultWoLUSet above (merc-only -> NO flag gate): member[0] is the UNMODIFIED
         vanilla effect C10CanisterRifle, so the bare id STILL FIRES -> the vanilla
         CActorAction id="GhostAttack" (effectAttack="C10CanisterRifle") keeps matching and the
         merc's rifle muzzle/impact (Ghost_AttackLaunch / Ghost_AttackImpact sounds + bunker-launch +
         BloodTargetImpact) are RESTORED. The vanilla member also delivers the player-resolved base hit
         (genlib's per-player C10CanisterRifle.Amount=20 / +10 Light reaches it). member[1] is the
         existing +50% clone C10CanisterRifleWoLU (30 / +15 Light, unchanged). The Senior Ghost's
         primary target now takes BOTH the base hit (~20 / +10 Light) AND the +50% clone (30 / +15
         Light) — owner-APPROVED damage increase (balance is an explicit non-goal). The hitscan rifle
         has no missile/beam actor, so only GhostAttack's launch/impact assets were detached; this
         re-includes the bare id to re-attach them. The weapon's <Effect> points at this set
         (WeaponData.xml); <DisplayEffect> stays C10CanisterRifleWoLU. Base Ghost / Nova / Tosh are
         UNAFFECTED (base Ghost fires vanilla C10CanisterRifle; Nova fires the separate Nova weapon ->
         Nova effect; only MercSeniorGhost's WeaponArray points at the C10CanisterRifleWoLU weapon). -->
    <CEffectSet id="C10CanisterRifleWoLUSet">
        <EffectArray value="C10CanisterRifle"/>
        <EffectArray value="C10CanisterRifleWoLU"/>
    </CEffectSet>

    <!-- Viking ground (Assault) Shredder Rounds + Anti-Mechanical Munition. Same
         TRIGGER-OVERRIDE shape as ThorsHammerWoLUSet above: member[0] is the UNMODIFIED
         vanilla effect TwinGatlingCannons, so the bare id STILL FIRES for everyone -> the
         vanilla CActorAction id="VikingAssaultAttack" (effectAttack="TwinGatlingCannons")
         keeps matching and its launch sound (VikingAssault_AttackLaunch) + impact sound
         (Viking_AssaultAttackImpact) + flesh blood-reaction (BloodTargetImpact) are RESTORED
         for every Viking (player AND enemy); the vanilla member also deals the enemy's exact
         vanilla damage (rule-9-neutral). member[1] is the player-only WoLUHasFlag splash +
         AttributeBonus[Mechanical] clone. NB the player's primary ground target takes BOTH the
         vanilla base hit AND the buffed clone — ACCEPTED (on-theme overpowered). GROUND plane
         SearchFilters (Crucio enemy-only pattern). This REPLACES the earlier action-clone
         re-bind (VikingAssaultAttack{Vanilla,}WoLU), which did NOT re-bind in-game. -->
    <CEffectSet id="TwinGatlingCannonsWoLUSet">
        <EffectArray value="TwinGatlingCannons"/>
        <EffectArray value="TwinGatlingCannonsWoLU"/>
    </CEffectSet>
    <CEffectDamage id="TwinGatlingCannonsWoLU" parent="TwinGatlingCannons">
        <ValidatorArray value="WoLUHasFlag"/>
        <Kind value="Splash"/>
        <KindSplash value="Splash"/>
        <SearchFilters value="Ground;Self,Player,Ally,Neutral,Missile,Stasis,Dead,Hidden,Invulnerable"/>
        <AreaArray Radius="0.8" Fraction="1"/>
        <AreaArray Radius="1.5" Fraction="0.5"/>
        <AttributeBonus index="Mechanical" value="20"/>
    </CEffectDamage>
    <!-- Hel's Angels merc ground attack. TRIGGER-OVERRIDE set (player-exclusive, no flag
         gate needed): member[0] is the UNMODIFIED vanilla effect WreckingCrewAssault, so the
         bare id STILL FIRES -> the vanilla CActorAction id="WreckingCrewAssaultAttack"
         (effectAttack="WreckingCrewAssault") keeps matching and its launch sound
         (VikingAssault_AttackLaunch) + impact sound (Viking_AssaultAttackImpact) + flesh
         blood-reaction are RESTORED for the merc; member[1] is the splash + mech-bonus clone.
         The merc's target takes the vanilla base hit AND the splash clone (on-theme overpowered;
         the merc is player-exclusive so rule 9 is moot). The weapon's <Effect> points at this set
         (WeaponData.xml). This REPLACES the earlier action-clone re-bind (WreckingCrewAssaultAttackWoLU). -->
    <CEffectSet id="WreckingCrewAssaultWoLUSet">
        <EffectArray value="WreckingCrewAssault"/>
        <EffectArray value="WreckingCrewAssaultWoLU"/>
    </CEffectSet>
    <!-- Hel's Angels merc ground splash (player-exclusive — no flag gate). Bigger radii +
         mech bonus than the base for the merc % advantage. -->
    <CEffectDamage id="WreckingCrewAssaultWoLU" parent="WreckingCrewAssault">
        <Kind value="Splash"/>
        <KindSplash value="Splash"/>
        <SearchFilters value="Ground;Self,Player,Ally,Neutral,Missile,Stasis,Dead,Hidden,Invulnerable"/>
        <AreaArray Radius="1.0" Fraction="1"/>
        <AreaArray Radius="1.8" Fraction="0.5"/>
        <AttributeBonus index="Mechanical" value="28"/>
    </CEffectDamage>

    <!-- Marine Magrail Munitions bonus shot. Instant damage; the railgun BEAM visual
         is a one-shot beam actor bound to this effect's Start (WoLUMagrailBeam in
         ActorData.xml), using the base-game WarHound railgun model. -->
    <CEffectDamage id="MagrailDamageWoLU" parent="DU_WEAP">
        <ImpactLocation Value="TargetUnit"/>
        <EditorCategories value="Race:Terran"/>
        <Kind value="Spell"/>
        <Amount value="20"/>
        <Death value="Normal"/>
    </CEffectDamage>

    <!-- Tactical Jump (AP): caster warps to the clicked point. Verbatim adaptation of the
         campaign SS_ScienceVesselTeleportTeleport (WhichUnit=Caster + TargetLocation=
         TargetPoint moves the caster to the target point). No persistent-invuln wrapper. -->
    <CEffectTeleport id="TacticalJumpWoLU">
        <EditorCategories value="Race:Terran"/>
        <WhichUnit Value="Caster"/>
        <TargetLocation Value="TargetPoint"/>
    </CEffectTeleport>

    <!-- Restoration (AP/BW Medic): strip all debuffs from a friendly target. Verbatim from
         Moebius RemoveDebuff (empty BehaviorLink + BehaviorAlignment=Negative removes every
         negatively-aligned behavior). -->
    <CEffectRemoveBehavior id="RestorationCleanseWoLU">
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <BehaviorLink value=""/>
        <BehaviorAlignment value="Negative"/>
    </CEffectRemoveBehavior>

    <!-- Optical Flare apply (AP Medic): blind the enemy target (form from BioStasisApplyBehavior). -->
    <CEffectApplyBehavior id="OpticalFlareApplyWoLU">
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <Behavior value="OpticalFlareBlindWoLU"/>
    </CEffectApplyBehavior>

    <!-- Science Vessel EMP Shockwave (BW SV): cloned launch+area so the AoE EXCLUDES own/allied
         units (vanilla EMPSearch SearchFilters "-;Hidden,Invulnerable" would drain our own
         energy/shields — friendly-fire-unsafe). Reuses AmmoUnit=EMP2Weapon (missile visual binds
         to it) and the vanilla EMPSet drain (energy + 100 shields, decloak, 0 HP). -->
    <CEffectLaunchMissile id="EMPShockwaveLaunchWoLU">
        <EditorCategories value="Race:Terran"/>
        <ImpactEffect value="EMPShockwaveSearchWoLU"/>
        <ImpactLocation Value="TargetPoint"/>
        <AmmoUnit value="EMP2Weapon"/>
    </CEffectLaunchMissile>
    <CEffectEnumArea id="EMPShockwaveSearchWoLU">
        <EditorCategories value="Race:Terran"/>
        <LaunchLocation Value="TargetPoint"/>
        <ImpactLocation Value="TargetPoint"/>
        <AreaArray Radius="3" Effect="EMPSet"/>
        <!-- Crucio enemy-only filter; "-;" plane hits air AND ground (BW EMP hit both). -->
        <SearchFilters value="-;Self,Player,Ally,Neutral,Missile,Stasis,Dead,Hidden,Invulnerable"/>
    </CEffectEnumArea>

    <!-- Defensive Matrix ON-DAMAGE trigger target (BC / Science Vessel / Jackson's Revenge).
         The WoLUDefMatrixOnDamage behavior (BehaviorData.xml) fires THIS set as its DamageResponse
         Handled effect — i.e. on the damage EVENT, not while merely below full HP. It mirrors the
         vanilla cast (which does APPLY the DefensiveMatrix buff + FILL shields to max) so the shield
         is actually up when the hit lands:
           - DefensiveMatrixApplyBehaviorWoLU applies the vanilla `DefensiveMatrix` buff
             (VitalMaxArray[Shields]=200, Duration=20, self-removes via RemoveValidatorArray=hasShields).
           - DefensiveMatrixFillWoLU fills Shields to max (ChangeFraction=1), same as the vanilla
             DefensiveMatrixModifyUnit.
         CRITICAL: every member pins the target to Caster EXPLICITLY — the apply-behavior via
         <WhichUnit Value="Caster"/>, the modify-unit via its own selector <ImpactUnit Value="Caster"/>.
         In a DamageResponse context "Caster" = the unit that carries the behavior = the DAMAGED unit.
         The bare campaign effects (DefensiveMatrixApplyBehavior / DefensiveMatrixModifyUnit) have NO
         explicit selector and default ambiguously here, so we clone them with the target pinned. We
         skip the vanilla
         dummy-behavior pair (DefensiveMatrixApplyDummyBehavior/RemoveDummyBehavior) — that's a
         cast-time gate artifact, irrelevant to a damage-response trigger. -->
    <CEffectApplyBehavior id="DefensiveMatrixApplyBehaviorWoLU">
        <EditorCategories value="Race:Terran"/>
        <Behavior value="DefensiveMatrix"/>
        <WhichUnit Value="Caster"/>
    </CEffectApplyBehavior>
    <CEffectModifyUnit id="DefensiveMatrixFillWoLU">
        <EditorCategories value="Race:Terran"/>
        <VitalArray index="Shields" ChangeFraction="1"/>
        <!-- CEffectModifyUnit's unit selector is <ImpactUnit> (NOT <WhichUnit>, which is the
             CEffectApplyBehavior form). Caster = the damaged unit in a DamageResponse context
             (confirmed valid: liberty's own CEffectModifyUnit uses <ImpactUnit Value="Caster"/>). -->
        <ImpactUnit Value="Caster"/>
    </CEffectModifyUnit>
    <CEffectSet id="DefensiveMatrixOnDamageSetWoLU">
        <EditorCategories value="Race:Terran"/>
        <EffectArray value="DefensiveMatrixApplyBehaviorWoLU"/>
        <EffectArray value="DefensiveMatrixFillWoLU"/>
    </CEffectSet>

    <!-- (Removed v0.3.25: the Raven SELF Point-Defense Laser effect cluster —
         PointDefenseLaserInitialSetWoLU / PointDefenseSearchWoLU / PointDefenseLaserSetWoLU /
         PointDefenseLaserEnergyWoLU. The static-weapon intercept never auto-fired in game. Raven
         point-defense is now the PASSIVE periodic behavior WoLURavenPointDefense (BehaviorData) →
         WoLURavenPDSearch (this file, below WoLUSVHealAuraHeal) → the vanilla PointDefenseLaserDamage,
         attached player-only in LibWoLUnbalanced.galaxy — it fires regardless of the Raven's order queue
         so point-defense works while the Raven moves. The old weapon (WeaponData.xml), the WeaponArray
         mount (UnitData.xml), and the firing-floor validator WoLUCasterHas1Energy (ValidatorData.xml)
         were deleted with the old cluster.) -->

    <!-- Wraith Trigger Override on-attack stack. Applies WoLUWraithTriggerOverride to the
         FIRING Wraith (WhichUnit=Source, the project convention for self-apply). Player-gated:
         WoLUHasFlag so enemy Wraiths fire the same weapon set but this apply no-ops for them. -->
    <CEffectApplyBehavior id="WoLUWraithTriggerOverrideApply">
        <EditorCategories value="Race:Terran"/>
        <Behavior value="WoLUWraithTriggerOverride"/>
        <WhichUnit Value="Source"/>
        <ValidatorArray value="WoLUHasFlag"/>
    </CEffectApplyBehavior>
    <!-- Air weapon set: original missile-pair delivery + on-fire stack. -->
    <CEffectSet id="WraithATriggerOverrideSet">
        <EditorCategories value="Race:Terran"/>
        <EffectArray value="WraithAPersistent"/>
        <EffectArray value="WoLUWraithTriggerOverrideApply"/>
    </CEffectSet>
    <!-- Ground weapon set: original missile launch + on-fire stack. -->
    <CEffectSet id="WraithGTriggerOverrideSet">
        <EditorCategories value="Race:Terran"/>
        <EffectArray value="WraithGLaunchMissile"/>
        <EffectArray value="WoLUWraithTriggerOverrideApply"/>
    </CEffectSet>

    <!-- ============================================================================
         Science Vessel Magellan: PASSIVE AUTO-HEAL AURA (v0.3.24 — replaces the abandoned
         Medivac-double-beam transplant, which did not heal in game: the Medivac heal-BEAM
         behavior system is fragile on a non-Medivac caster). This is a continuous, FREE
         passive that heals ALL nearby friendly units (biological + mechanical + air, incl.
         friendly STRUCTURES) ~16 HP/s, built on the basic life-add primitive — the same robust
         class as our WoLU* per-tick buffs. Wiring: the buff WoLUSVHealAura (BehaviorData.xml)
         ticks Period 0.0625 s and fires WoLUSVHealAuraSearch, an area enum that applies
         WoLUSVHealAuraHeal (+1 Life) to each friendly found. GRANULAR (v0.3.x): tiny 1-HP steps
         at 16 ticks/s so units no longer die between big 1-second heal chunks. Player-only: the
         buff is attached ONLY to the human player's Science Vessels via libWoLU_AddBehaviorToType
         (rule 9 — the Medivac + enemy SVs are untouched).
         ============================================================================ -->

    <!-- Aura area search: every tick the buff fires this; it heals up to 12 friendlies in radius 7.
         SearchFilters is the CRUCIO friendly-fire guard: the plane token `Visible` admits BOTH
         ground and air (the SV flies and heals air — do NOT require the Ground plane), and the
         post-`;` EXCLUDE set drops Neutral, Enemy, Stasis, Dead, Hidden, Missile, Invulnerable.
         Self/Player/Ally are NOT in the exclude set → they ARE healed (the SV heals itself + its
         allies). HEAL BUILDINGS (v0.3.x): `Structure` was REMOVED from the exclude set so friendly
         STRUCTURES now heal too (owner request). Enemy + Neutral remain excluded, so the search
         can never hit an enemy — friendly structures are included, but enemy/neutral ones are NOT,
         so the aura still cannot leak a heal to the other side (rule 9 + the Crucio rule). -->
    <CEffectEnumArea id="WoLUSVHealAuraSearch">
        <EditorCategories value="Race:Terran"/>
        <AreaArray Radius="7" MaxCount="12" Effect="WoLUSVHealAuraHeal"/>
        <SearchFilters value="Visible;Neutral,Enemy,Stasis,Dead,Hidden,Missile,Invulnerable"/>
    </CEffectEnumArea>

    <!-- The per-tick heal: a generic life-add → heals bio AND mech AND structures (a CEffectModifyUnit
         Life change is vital-agnostic, unlike CEffectCreateHealer). GRANULAR (v0.3.x): +1 Life/tick ×
         Period 0.0625 s = ~16 HP/s — tiny steps at 16 ticks/s instead of one big +15 every 1.0 s, so
         units no longer die between heal chunks. NO <ImpactUnit> — an area-search-applied effect targets
         the SEARCHED unit by default; adding Value="Caster" would redirect every tick onto the SV
         itself. NO energy cost. NO SearchFilters (this is a modify, not a search). -->
    <CEffectModifyUnit id="WoLUSVHealAuraHeal">
        <EditorCategories value="Race:Terran"/>
        <VitalArray index="Life" Change="1"/>
    </CEffectModifyUnit>

    <!-- SV heal-GLOW search (v0.3.x). Fired once/sec by WoLUSVHealAuraGlow (BehaviorData) to drive the
         visual pulse at a calm cadence (the HEAL stays granular at 16x/s via WoLUSVHealAuraSearch). Same
         Radius/MaxCount and IDENTICAL SearchFilters as WoLUSVHealAuraSearch so it finds the SAME friendlies
         (bio + mech + air + friendly structures) and NEVER an enemy/neutral (Enemy + Neutral stay excluded
         → rule 9 + the Crucio rule). Applies the no-op marker WoLUSVHealAuraGlowMark to each → the pulse
         actor binds to that marker's .Start. -->
    <CEffectEnumArea id="WoLUSVHealAuraGlowPing">
        <EditorCategories value="Race:Terran"/>
        <AreaArray Radius="7" MaxCount="12" Effect="WoLUSVHealAuraGlowMark"/>
        <SearchFilters value="Visible;Neutral,Enemy,Stasis,Dead,Hidden,Missile,Invulnerable"/>
    </CEffectEnumArea>

    <!-- SV heal-GLOW marker (v0.3.x). A zero-change CEffectModifyUnit = a harmless no-op that still raises
         Effect.WoLUSVHealAuraGlowMark.Start on each searched target. The pulse actor (WoLUSVHealAuraPulse,
         ActorData) binds to THIS effect's .Start so the glow fires ONCE PER SECOND PER HEALED UNIT, not on
         every 16x/s heal tick. NO <ImpactUnit> — an area-search-applied effect targets the SEARCHED unit by
         default (the healed friendly), so the pulse hosts on each healed unit, NOT the SV (adding
         Value="Caster" would redirect every glow onto the SV itself — the old "shows above the SV" symptom).
         NO cost, NO SearchFilters (this is a modify, not a search). -->
    <CEffectModifyUnit id="WoLUSVHealAuraGlowMark">
        <EditorCategories value="Race:Terran"/>
        <VitalArray index="Life" Change="0"/>
    </CEffectModifyUnit>

    <!-- Raven point-defense SEARCH (v0.3.x — replaces the script interceptor). Fired every 0.0625 s by
         WoLURavenPointDefense (BehaviorData) to find nearby enemy MISSILES and apply the VANILLA
         PointDefenseLaserDamage (REUSED, NOT cloned — it has Hide + NullifyMissile and NO caster-identity
         validator, so any caster fires it → engine nullify + the vanilla blue beam from the Raven). The
         behavior's caster is the Raven, so PointDefenseLaserDamage's caster = the Raven and the beam draws
         Raven→missile. Radius 16 (matches the old script's detection radius). SearchFilters copied
         VERBATIM from the vanilla PointDefenseSearch (mods/_reference/.../liberty.sc2mod/EffectData.xml:519
         `Missile,Visible;Self,Player,Ally,Neutral,Stasis,Dead,Hidden,Invulnerable`): REQUIRE Missile +
         Visible (keep Missile on the require side — it is exactly what we want to hit), EXCLUDE
         Self/Player/Ally/Neutral/Stasis/Dead/Hidden/Invulnerable (the Crucio rule — never nullify our own
         or an ally's missiles, never touch enemy/neutral non-missiles). MaxCount 12 = up to 12 missiles per
         tick (a salvo). Player-only by construction: the behavior is attached only to the player's Ravens. -->
    <CEffectEnumArea id="WoLURavenPDSearch">
        <EditorCategories value="Race:Terran"/>
        <AreaArray Radius="16" MaxCount="12" Effect="PointDefenseLaserDamage"/>
        <SearchFilters value="Missile,Visible;Self,Player,Ally,Neutral,Stasis,Dead,Hidden,Invulnerable"/>
    </CEffectEnumArea>
</Catalog>
