<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Super Stimpack effect chain — verbatim clone of NCO SuperStimpackMarine /
         SuperStimpackMarauderHellbat chains (novastoryassets.sc2mod EffectData.xml),
         ids renamed: CEffectSet -> apply WoLUSuperStim buff + CEffectModifyUnit heal.
         Heal 30 for the Marine line, 60 for Marauder/Firebat lines (unit-table spec,
         matches NCO's 30/60 split). Schema notes vs the failed first attempt: the
         heal must be the ATTRIBUTE form (VitalArray ... Change="..."), and both
         effects target Source, not Caster. -->
    <CEffectApplyBehavior id="WoLUStimApply">
        <EditorCategories value="Race:Terran"/>
        <Behavior value="WoLUSuperStim"/>
        <WhichUnit Value="Source"/>
    </CEffectApplyBehavior>
    <CEffectSet id="WoLUStimSet">
        <EditorCategories value="Race:Terran"/>
        <EffectArray value="WoLUStimApply"/>
        <EffectArray value="WoLUStimSetMU"/>
    </CEffectSet>
    <CEffectModifyUnit id="WoLUStimSetMU">
        <EditorCategories value="Race:Terran"/>
        <VitalArray index="Life" Change="30"/>
        <ImpactUnit Value="Source"/>
    </CEffectModifyUnit>
    <CEffectSet id="WoLUStimMarauderSet">
        <EditorCategories value="Race:Terran"/>
        <EffectArray value="WoLUStimApply"/>
        <EffectArray value="WoLUStimMarauderSetMU"/>
    </CEffectSet>
    <CEffectModifyUnit id="WoLUStimMarauderSetMU">
        <EditorCategories value="Race:Terran"/>
        <ImpactUnit Value="Source"/>
        <VitalArray index="Life" Change="60"/>
    </CEffectModifyUnit>

    <!-- Thor ground attack with sieged-tank-style splash. The vanilla ThorsHammer
         weapon's Effect is overridden to this set (WeaponData.xml) — keeping the
         weapon id so attack animations still fire. The set is GLOBAL (enemy Thors
         fire it too), so per-player isolation happens HERE at the effect level (the
         campaign's Shaped Blast pattern): both branches are validator-gated on the
         flag upgrade only the human player has — splash for us, exact vanilla damage
         for everyone else. -->
    <CEffectSet id="ThorsHammerWoLUSet">
        <EffectArray value="ThorsHammerDamageVanillaWoLU"/>
        <EffectArray value="ThorsHammerDamageWoLU"/>
    </CEffectSet>
    <CEffectDamage id="ThorsHammerDamageVanillaWoLU" parent="ThorsHammerDamage">
        <ValidatorArray value="WoLUNoFlag"/>
    </CEffectDamage>
    <CEffectDamage id="ThorsHammerDamageWoLU" parent="ThorsHammerDamage">
        <ValidatorArray value="WoLUHasFlag"/>
        <Kind value="Splash"/>
        <KindSplash value="Splash"/>
        <!-- Enemy-only splash (same filter pattern as the campaign's Crucio enemy
             damage): never hits own/allied/neutral units. -->
        <SearchFilters value="Ground;Self,Player,Ally,Neutral,Missile,Stasis,Dead,Hidden,Invulnerable"/>
        <!-- Splash radius doubled (user request): 0.8/1.25 -> 1.6/2.5. -->
        <AreaArray Radius="1.6" Fraction="1"/>
        <AreaArray Radius="2.5" Fraction="0.5"/>
    </CEffectDamage>

    <!-- Marine Magrail Munitions bonus shot. Instant damage; the railgun BEAM visual
         is a one-shot beam actor bound to this effect's Start (WoLUMagrailBeam in
         ActorData.xml), using the base-game WarHound railgun model. -->
    <CEffectDamage id="MagrailDamageWoLU" parent="DU_WEAP">
        <ImpactLocation Value="TargetUnit"/>
        <EditorCategories value="Race:Terran"/>
        <Kind value="Spell"/>
        <Amount value="20"/>
        <Death value="Normal"/>
    </CEffectDamage>

    <!-- Tactical Jump (AP): caster warps to the clicked point. Verbatim adaptation of the
         campaign SS_ScienceVesselTeleportTeleport (WhichUnit=Caster + TargetLocation=
         TargetPoint moves the caster to the target point). No persistent-invuln wrapper. -->
    <CEffectTeleport id="TacticalJumpWoLU">
        <EditorCategories value="Race:Terran"/>
        <WhichUnit Value="Caster"/>
        <TargetLocation Value="TargetPoint"/>
    </CEffectTeleport>

    <!-- Restoration (AP/BW Medic): strip all debuffs from a friendly target. Verbatim from
         Moebius RemoveDebuff (empty BehaviorLink + BehaviorAlignment=Negative removes every
         negatively-aligned behavior). -->
    <CEffectRemoveBehavior id="RestorationCleanseWoLU">
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <BehaviorLink value=""/>
        <BehaviorAlignment value="Negative"/>
    </CEffectRemoveBehavior>

    <!-- Optical Flare apply (AP Medic): blind the enemy target (form from BioStasisApplyBehavior). -->
    <CEffectApplyBehavior id="OpticalFlareApplyWoLU">
        <EditorCategories value="Race:Terran,AbilityorEffectType:Units"/>
        <Behavior value="OpticalFlareBlindWoLU"/>
    </CEffectApplyBehavior>
</Catalog>
