    CatalogFieldValueModify(c_gameCatalogUnit, "Spectre", "Sight", p, "2", c_upgradeOperationAdd);
    CatalogFieldValueModify(c_gameCatalogUnit, "Hellion", "LifeArmor", p, "2", c_upgradeOperationAdd);  // Hellion Infernal Plating
    CatalogFieldValueModify(c_gameCatalogUnit, "Medivac", "ShieldsMax", p, "100", c_upgradeOperationSet);  // Medivac Scatter Veil: +100 shields
    CatalogFieldValueModify(c_gameCatalogUnit, "Medivac", "ShieldsStart", p, "100", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogUnit, "VikingAssault", "Speed", p, "1.55", c_upgradeOperationMultiply);  // Viking Aesir Turbines: +55% speed
    CatalogFieldValueModify(c_gameCatalogUnit, "VikingFighter", "Speed", p, "1.55", c_upgradeOperationMultiply);
    CatalogFieldValueModify(c_gameCatalogWeapon, "Diamondback", "Range", p, "3", c_upgradeOperationAdd);  // Diamondback Tri-Lithium Power Cell max: +3 range
    CatalogFieldValueModify(c_gameCatalogUnit, "SiegeTankSieged", "LifeArmor", p, "3", c_upgradeOperationAdd);  // Tank Advanced Siege Tech: +3 armor sieged
    CatalogFieldValueModify(c_gameCatalogWeapon, "BacklashRockets", "Range", p, "8", c_upgradeOperationSet);  // Banshee Advanced Targeting Optics: +2 range (folded flat — player banshees are perma-cloaked)
    CatalogFieldValueModify(c_gameCatalogEffect, "BacklashRocketsU", "Amount", p, "1.25", c_upgradeOperationMultiply);  // Banshee Distortion Blasters: +25% dmg (folded flat)
    CatalogFieldValueModify(c_gameCatalogAbil, "NanoRepair", "Cost[0].Vital[Energy]", p, "0", c_upgradeOperationSet);  // Science Vessel Improved Nano-Repair: free heal
    CatalogFieldValueModify(c_gameCatalogEffect, "OdinAADamage", "Amount", p, "35", c_upgradeOperationSet);  // Odin AA mirrors Thor: HIP floor 35/rocket (was 15, no light bonus)
    CatalogFieldValueModify(c_gameCatalogAbil, "heal", "Range", p, "4", c_upgradeOperationSet);  // Medic Nano Projector: +2 heal range (2->4)
    CatalogFieldValueModify(c_gameCatalogAbil, "heal", "TargetFilters", p, "Visible;Self,Enemy,Structure,Missile,UnderConstruction,Dead,Hidden,Invulnerable", c_upgradeOperationSet);  // Medic Adaptive Medpacks: heal mech + air (drops Ground,Biological requirement) — string-field edit, verify in game
    CatalogFieldValueModify(c_gameCatalogWeapon, "Diamondback", "Period", p, "0.75", c_upgradeOperationMultiply);  // Diamondback Hyperfluxor: faster attack (-25%, assumption)
    CatalogFieldValueModify(c_gameCatalogUnit, "Diamondback", "Speed", p, "1.25", c_upgradeOperationMultiply);  // Diamondback Maglev Propulsion (+25%, assumption)
    CatalogFieldValueModify(c_gameCatalogBehavior, "AutoTurretTimedLife", "Duration", p, "3600", c_upgradeOperationSet);  // Raven: permanent Auto-Turrets (AP Durable Materials, maxed)
    CatalogFieldValueModify(c_gameCatalogBehavior, "PointDefenseDroneTimedLife", "Duration", p, "3600", c_upgradeOperationSet);  // Raven: permanent Point Defense Drones

    // --- Engineering Bay: combined upgrades research in 30 s (weapon/armor levels) ---
    CatalogFieldValueModify(c_gameCatalogAbil, "EngineeringBayResearch", "InfoArray[Research3].Time", p, "30", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogAbil, "EngineeringBayResearch", "InfoArray[Research4].Time", p, "30", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogAbil, "EngineeringBayResearch", "InfoArray[Research5].Time", p, "30", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogAbil, "EngineeringBayResearch", "InfoArray[Research7].Time", p, "30", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogAbil, "EngineeringBayResearch", "InfoArray[Research8].Time", p, "30", c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogAbil, "EngineeringBayResearch", "InfoArray[Research9].Time", p, "30", c_upgradeOperationSet);
}
