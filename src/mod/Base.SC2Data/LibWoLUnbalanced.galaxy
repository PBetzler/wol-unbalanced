//==================================================================================================
// WoL Unbalanced — per-player data application library
//
// Rule 9: all stat changes apply ONLY to the human player (player 1); enemies keep vanilla
// values. Therefore stat edits happen here via per-player catalog modification, not in the
// static XML catalogs (those only carry definitions: new abilities, effects, buttons, upgrades).
//
// The build pipeline injects `include "LibWoLUnbalanced"` and a `libWoLU_InitLib()` call into every
// map's MapScript.galaxy — maps are never re-saved in the editor.
//==================================================================================================
include "TriggerLibs/NativeLib"
include "LibWoLUnbalancedGen"

const int libWoLU_Player = 1;

// --- Skip-Prophecy feature state (tstory01 Hyperion hub only) ----------------
// File-scope handles for the one-time "Skip Prophecy (Zeratul) missions" button.
// Both start as the engine's invalid sentinels so the deferred creator can detect
// "not yet created" and the click handler can match the exact control. c_invalidDialogId
// / c_invalidDialogControlId are base-game constants (used throughout CampaignLib).
int libWoLU_gv_skipProphecyDialog = c_invalidDialogId;
int libWoLU_gv_skipProphecyButton = c_invalidDialogControlId;

// Forward declarations — Galaxy is single-pass; anything called before its
// definition in this file must be prototyped here.
void libWoLU_SyncWeaponArmorLevels (int p);
void libWoLU_DisableArmoryResearch (int p);
void libWoLU_AddBehaviorToType (int p, string unitType, string behavior);
void libWoLU_GraduateSiegeRange (int p, string unitType);
void libWoLU_SynthesizeVespene (int p);
void libWoLU_ForceGrantAllTechRewards (int p);
void libWoLU_EnableCurrentMissionUnits (int p);
// Skip-Prophecy feature (definitions below; forward-declared for the single-pass
// compiler because libWoLU_InitLib and the deferred handler reference them earlier).
bool libWoLU_ShouldOfferSkipProphecy (int p);
void libWoLU_CreateSkipProphecyButton ();
bool libWoLU_OnCrystalZeratulScreen (int p);   // true iff on the star-map crystal with a Zeratul report selected
void libWoLU_SkipProphecyMissions (int p);
string libWoLU_b2s (bool v);            // bool -> "1"/"0" for diag subtitles
void libWoLU_PurchaseAllMercs (int p);  // re-assert every merc Purchased (hub re-grant)

void libWoLU_ApplyPlayer (int p) {
    libWoLUGen_Apply(p);
}

bool libWoLU_OnMapInit (bool testConds, bool runActions) {
    libWoLU_ApplyPlayer(libWoLU_Player);
    // No on-screen message here: map init usually falls inside the intro cinematic,
    // where subtitle messages expire unseen. The visible canary fires with the tech
    // grant below instead.
    return true;
}

// Rules 2/3/6 + "both sides of every choice": grant the full armory, purchase every
// non-locked merc (locked = counterpart not yet unlocked, which keeps rule 3 intact),
// sync both halves of each lab-research pair, and unlock both story-branch units.
// Runs AFTER the mission's own libCamp_gf_ApplyCampaignTech (we re-apply on top via
// Blizzard's own functions, so UI/help/merc panels stay consistent).
void libWoLU_GrantCampaignTech (int p) {
    int i;

    if (PlayerRace(p) != "Terr") {
        return; // Protoss interludes manage their own tech; nothing to grant there.
    }

    // Ghost/Spectre story branch: if either side is unlocked, enable both groups.
    if ((libCamp_gv_tS_TechGroupState[libCamp_ge_StoryTechGroup_StoryTechGroupDominionGhost] == c_purchaseCategoryStateEnabled) || (libCamp_gv_tS_TechGroupState[libCamp_ge_StoryTechGroup_StoryTechGroupDominionSpectre] == c_purchaseCategoryStateEnabled)) {
        libCamp_gv_tS_TechGroupState[libCamp_ge_StoryTechGroup_StoryTechGroupDominionGhost] = c_purchaseCategoryStateEnabled;
        libCamp_gv_tS_TechGroupState[libCamp_ge_StoryTechGroup_StoryTechGroupDominionSpectre] = c_purchaseCategoryStateEnabled;
    }

    // Lab research: both sides of every pair (ids 1/2, 3/4, ... 19/20 — includes
    // Raven/Science Vessel and Predator/Hercules).
    i = 1;
    while (i <= 19) {
        if ((libCamp_gv_tSX_ResearchState[i] == libCamp_ge_StoryResearchState_ResearchStatePurchased) || (libCamp_gv_tSX_ResearchState[(i + 1)] == libCamp_ge_StoryResearchState_ResearchStatePurchased)) {
            libCamp_gv_tSX_ResearchState[i] = libCamp_ge_StoryResearchState_ResearchStatePurchased;
            libCamp_gv_tSX_ResearchState[(i + 1)] = libCamp_ge_StoryResearchState_ResearchStatePurchased;
        }
        i = i + 2;
    }

    // Rule 2: every armory upgrade counts as purchased.
    libCamp_gf_TS_BuyAllTech();

    // Rule 6 + user override of rule 3 ("all mercs available from the beginning,
    // always unlocked, with upgrades" — speeds up testing and fits the mod's
    // everything-unlocked spirit): mark EVERY campaign merc Purchased unconditionally,
    // even before its counterpart unit exists in the story. ApplyMercenaryTech below
    // then allows each merc's calldown command (it gates purely on Purchased status),
    // and ApplyMercUpgrades grants their upgrades. The genlib already makes the
    // calldowns unlimited-charge and ready at mission start (Merc Compound still
    // required to exist). This is exactly the state you'd reach by hiring every merc
    // on the Hyperion, applied at every mission init.
    i = libCamp_gv_TSC_MERC_FIRST;
    while (i <= libCamp_gv_TSC_MERC_LAST) {
        libCamp_gf_SetMercStatus(libCamp_gv_tS_MercID[i], libCamp_ge_StoryMercStatus_Purchased);
        i = i + 1;
    }

    // Re-apply everything through the campaign's own code paths.
    libCamp_gf_ApplyCampaignTech(p);
    libCamp_gf_TS_ApplyMercenaryTech(p);
    libCamp_gf_TS_ApplyMercUpgrades(p);
    // The merc UNIT must be allowed for its calldown to work (only War Pigs appeared
    // otherwise — its counterpart Marine is unlocked). Allow the merc unit types DIRECTLY.
    // (v0.2.1 used EnableCampaignTechUnit on the merc tech subgroups, but those map to the
    // COUNTERPART unit's group — it wrongly unlocked Marauder/Firebat/Factory/etc. and did
    // NOT enable the calldowns. Reverted.)
    TechTreeUnitAllow(p, "WarPig", true);
    TechTreeUnitAllow(p, "DevilDog", true);
    TechTreeUnitAllow(p, "HammerSecurity", true);
    TechTreeUnitAllow(p, "SpartanCompany", true);
    TechTreeUnitAllow(p, "SiegeBreaker", true);
    TechTreeUnitAllow(p, "SiegeBreakerSieged", true);
    TechTreeUnitAllow(p, "HelsAngelFighter", true);
    TechTreeUnitAllow(p, "HelsAngelAssault", true);
    TechTreeUnitAllow(p, "DuskWing", true);
    TechTreeUnitAllow(p, "DukesRevenge", true);
    libWoLU_SyncWeaponArmorLevels(p);
    libWoLU_DisableArmoryResearch(p);

    // Units available DURING their unlock mission (not only after completing it).
    // The campaign only enables a mission's unit tech groups once that mission is
    // COMPLETED (see CampaignLib: the state rebuild gates mission-unlocked subgroups
    // on MissionStatusCheck Completed), so e.g. the Medic — unlocked by mission 2 —
    // isn't buildable while you PLAY mission 2. Enable the CURRENT map's unlocked
    // tech groups too (EnableCampaignTechUnit also allows the unit's train command).
    libWoLU_EnableCurrentMissionUnits(p);

    // Branch units last — the apply pass above may have re-restricted them.
    // ITEM 2 (v0.3.30): fire when EITHER branch group is enabled (mirror the OR-pattern at
    // the top of this function). The OLD gate keyed ONLY on the Ghost group == Enabled, but
    // libCamp_gf_ApplyCampaignTech(p) above runs libCamp_gf_TS_UpdateTechGroupStates(), which
    // RESETS every TechGroupState to Hidden then re-enables only completed-mission groups — so
    // in the Spectre-unlocked-but-Ghost-not scenario the Ghost group was reset to Hidden, the
    // gate was FALSE, and the Ghost was never re-allowed (owner: only Spectre buildable). The
    // same reset also runs EnableCampaignTechUnit(false, Ghost), which DISABLES the Ghost train
    // command — so TechTreeUnitAllow alone isn't enough; we must also re-allow the train command
    // explicitly. Command indices verified against CampaignLib.galaxy:6918/6925 (the campaign's
    // own EnableCampaignTechUnit map): Ghost = BarracksTrain index 2 (InfoArray Train3),
    // Spectre = BarracksTrain index 6 (InfoArray Train7). This runs AFTER ApplyCampaignTech, so
    // it is the last word.
    if ((libCamp_gv_tS_TechGroupState[libCamp_ge_StoryTechGroup_StoryTechGroupDominionGhost] == c_purchaseCategoryStateEnabled)
        || (libCamp_gv_tS_TechGroupState[libCamp_ge_StoryTechGroup_StoryTechGroupDominionSpectre] == c_purchaseCategoryStateEnabled)) {
        TechTreeUnitAllow(p, "Ghost", true);
        TechTreeUnitAllow(p, "Spectre", true);
        TechTreeAbilityAllow(p, AbilityCommand("BarracksTrain", 2), true);  // Ghost (Train3)
        TechTreeAbilityAllow(p, AbilityCommand("BarracksTrain", 6), true);  // Spectre (Train7)
    }

    // ITEM 3b (v0.3.30): Psi Disruptor not buildable — clear the PsiDisruptor SCV-build
    // command's Restricted state for the human player. The card collision is fixed in
    // UnitData.xml (3a), and the research pair is already granted by the lab-research loop,
    // but PsiDisruptor's TerranBuild InfoArray[Build8].Button.State="Restricted" (libertystory)
    // keeps the command unusable even after the cell is freed (HiveMind's Build22 has State=None
    // and is unaffected). Command index 7 = Build8 (verified: TerranBuild AbilityCommand index =
    // numeric BuildN - 1, cross-checked vs CampaignLib.galaxy:723/732 where Factory=Build11→10,
    // Starport=Build12→11). Player-only via TechTreeAbilityAllow(p, ...) → rule-9-safe.
    TechTreeAbilityAllow(p, AbilityCommand("TerranBuild", 7), true);  // PsiDisruptor (Build8) — clear Restricted

    // Rule 2, strict reading: upgrades exist already in the unit's UNLOCK mission.
    // BuyAllTech is undone by the engine for tech groups the story hasn't introduced
    // yet (e.g. everything during Liberation Day), so grant every armory tech's
    // rewards directly, bypassing the group gate. Mercs stay group-gated (rule 3).
    libWoLU_ForceGrantAllTechRewards(p);

    // Unlock the WoLU clone abilities (autocast Super Stimpack etc.) — the flag
    // upgrade is the requirement gate that only the human player ever satisfies.
    TechTreeUpgradeAddLevel(p, "WoLUnbalancedFlag", 1);

    // Smart Servos (AP): faster Viking transform via the player-only WoLUSmartServos CUpgrade
    // (EffectArray Subtract on the morph durations, the rogue Kit@AISmartServos pattern). RE-ENABLED
    // v0.3.18: I had disabled this in v0.3.16 suspecting it crashed the grant ("no canary / no mercs"),
    // but the ACTUAL root cause was the install path (build.py was writing to Program Files instead of
    // Documents\StarCraft II, so the mod never loaded — see CLAUDE.md Hard Rules). WoLUSmartServos was
    // a false suspect: its EffectArray Reference paths all resolve against the real morph defs
    // (AssaultMode/FighterMode + the Hel's Angels WreckingCrew*Mode). The fire-while-moving half is a
    // separate per-player Weapon.AllowedMovement edit in genlib.
    TechTreeUpgradeAddLevel(p, "WoLUSmartServos", 1);

    // Extra elite-merc calldowns (Field Engineer Zeta / Grim Reaper / Condor) are added
    // in static XML as SummonMercenaries Train9-11. They're not in the campaign merc-panel
    // system, so allow their unit types directly (their hire buttons are un-restricted).
    TechTreeUnitAllow(p, "MercMedic", true);
    TechTreeUnitAllow(p, "MercReaper", true);
    TechTreeUnitAllow(p, "MercHellion", true);
    TechTreeUnitAllow(p, "MercThor", true);
    TechTreeUnitAllow(p, "MercWraith", true);
    TechTreeUnitAllow(p, "MercSeniorGhost", true);

    // Command Center OP economy (user request): the player's CC gets a free, unlimited
    // Calldown: MULE + Extra Supplies kit (CalldownMULEWoLU/SupplyDropWoLU clones, gated
    // on WoLUHaveFlag so enemy CCs stay vanilla). Allow the MULE unit + the clone abils so
    // they're usable without the (campaign-absent) Orbital Command upgrade.
    TechTreeUnitAllow(p, "MULE", true);
    TechTreeAbilityAllow(p, AbilityCommand("CalldownMULEWoLU", 0), true);
    TechTreeAbilityAllow(p, AbilityCommand("SupplyDropWoLU", 0), true);

    // #6: Jackson's Revenge autocast kit. The Missile Pods + Defensive Matrix clones
    // inherit State="Restricted" from their parents (cleared to "Normal" in AbilData);
    // also explicitly allow the three DR clone abilities so nothing else gates them.
    TechTreeAbilityAllow(p, AbilityCommand("DukesRevengeYamatoWoLU", 0), true);
    TechTreeAbilityAllow(p, AbilityCommand("DukesRevengeMissilePodsWoLU", 0), true);
    TechTreeAbilityAllow(p, AbilityCommand("DukesRevengeDefensiveMatrixWoLU", 0), true);
}

void libWoLU_ForceGrantAllTechRewards (int p) {
    int i;
    int j;
    int techID;
    i = libCamp_gv_TSC_TECH_FIRST;
    while (i <= libCamp_gv_TSC_TECH_LAST) {
        techID = libCamp_gv_tS_TechID[i];
        j = 1;
        while (j <= libCamp_gv_tSC_TECH_AC_COUNT) {
            if ((libCamp_gf_StoryTechAbilityCommand(techID, j) != null)) {
                TechTreeAbilityAllow(p, libCamp_gf_StoryTechAbilityCommand(techID, j), true);
            }
            j = j + 1;
        }
        j = 1;
        while (j <= libCamp_gv_tSC_TECH_UG_COUNT) {
            if ((libCamp_gf_StoryTechUpgrade(techID, j) != null)) {
                libNtve_gf_SetUpgradeLevelForPlayer(p, libCamp_gf_StoryTechUpgrade(techID, j), 1);
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

// Enable the CURRENT mission's unlocked unit tech groups (so units are buildable
// during their unlock mission, not only after completing it). Each mission registers
// up to 3 unlocked tech subgroups (CampaignLib map data); EnableCampaignTechUnit sets
// the group enabled AND allows the unit's train command.
void libWoLU_EnableCurrentMissionUnits (int p) {
    int j;
    int grp;
    j = 1;
    while (j <= 3) {
        grp = libCamp_gf_MissionUnlockedTechSubgorup(libCamp_gv_tS_CurrentMap, j);
        if ((grp != libCamp_ge_StoryTechGroup_StoryTechGroupNone)) {
            libCamp_gf_EnableCampaignTechUnit(true, grp, p);
        }
        j = j + 1;
    }
}

bool libWoLU_OnGrantTech (bool testConds, bool runActions) {
    libWoLU_GrantCampaignTech(libWoLU_Player);
    // Visible proof the mod ran and the grant executed (fires at 1 s and 10 s; the
    // 10 s one is the canary you'll actually see after skipping the intro).
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("WoL Unbalanced v__WOLU_VERSION__ (build __WOLU_BUILD__): data applied, upgrades & mercs granted."));
    // (Per-issue diagnostic subtitles removed — all the v0.3.30 fixes are owner-confirmed in game,
    // per the "clean the markers up afterwards" rule. The versioned canary above stays as the
    // permanent load-proof; add a focused diag line back here only when a new issue is under debug.)
    return true;
}

// Engineering Bay rework: its infantry weapon/armor researches (30 s, see generated
// lib) act as COMBINED upgrades — completing level N also grants the vehicle and ship
// equivalents. The Armory building's own researches are disabled as redundant.
//
// DETECTION FIX (the buff-only-infantry bug): the Eng Bay button the player clicks differs
// by LAB STATE, and the two buttons research INDEPENDENT upgrade families:
//   BEFORE-lab (the "normal" state, the default at mission start) the Eng Bay shows
//     Research3/4/5 (weapons) + Research7/8/9 (armors), which grant the BASE ids
//     TerranInfantryWeapons/ArmorsLevel{N} (liberty.sc2mod AbilData.xml:1699-1734).
//   AFTER the lab Ultra-Capacitors / Vanadium-Plating research, those base buttons HIDE
//     (their .Show drops them) and Research11/12/13 + Research14/15/16 appear, granting the
//     icon-only WRAPPER ids TerranInfantryWeaponsUltraCapacitorsLevel{N} /
//     TerranInfantryArmorsVanadiumPlatingLevel{N} (libertystory.sc2campaign AbilData.xml:172-201).
// The wrapper is parent="…UltraCapacitors"/"…VanadiumPlating", NOT parent="…Level{N}", so the
// two families are SEPARATE tech-tree entries: researching one leaves the other's
// TechTreeUpgradeCount at 0. Keying detection off ONLY one family misses the other lab state
// (the original bug detected only the base ids → before-lab worked, after-lab didn't, so the
// vehicle/ship grants never fired then). We therefore OR BOTH families per level (an
// absent/incomplete id just returns 0, so checking the extra id is harmless). The GRANT targets
// stay the BASE TerranVehicle/ShipWeapons/ArmorsLevel{N} ids — those carry the real
// +damage/+level/+armor EffectArrays for Thor/Goliath/Diamondback/Siege Tank/Wraith/BC/
// Hercules/etc (incl. mercs/heroes, libertystory UpgradeData.xml). Do NOT grant the
// UltraCapacitors/VanadiumPlating VEHICLE/SHIP wrapper variants — they're icon-only (no effect)
// and granting any duplicate-effect upgrade would double-apply. The per-target == 0 guard keeps
// the 2 s periodic from re-granting (idempotent).
void libWoLU_SyncWeaponArmorLevels (int p) {
    int n;
    string lvl;
    n = 1;
    while (n <= 3) {
        lvl = IntToString(n);
        // Weapons: fire when EITHER the campaign's UltraCapacitors wrapper OR the base
        // infantry-weapons Level upgrade is complete (OR-detection robust to the id ambiguity).
        if (TechTreeUpgradeCount(p, "TerranInfantryWeaponsUltraCapacitorsLevel" + lvl, c_techCountCompleteOnly) > 0
            || TechTreeUpgradeCount(p, "TerranInfantryWeaponsLevel" + lvl, c_techCountCompleteOnly) > 0) {
            if (TechTreeUpgradeCount(p, "TerranVehicleWeaponsLevel" + lvl, c_techCountCompleteOnly) == 0) {
                TechTreeUpgradeAddLevel(p, "TerranVehicleWeaponsLevel" + lvl, 1);
            }
            if (TechTreeUpgradeCount(p, "TerranShipWeaponsLevel" + lvl, c_techCountCompleteOnly) == 0) {
                TechTreeUpgradeAddLevel(p, "TerranShipWeaponsLevel" + lvl, 1);
            }
        }
        // Armor: fire when EITHER the campaign's VanadiumPlating wrapper OR the base
        // infantry-armors Level upgrade is complete.
        if (TechTreeUpgradeCount(p, "TerranInfantryArmorsVanadiumPlatingLevel" + lvl, c_techCountCompleteOnly) > 0
            || TechTreeUpgradeCount(p, "TerranInfantryArmorsLevel" + lvl, c_techCountCompleteOnly) > 0) {
            if (TechTreeUpgradeCount(p, "TerranVehicleArmorsLevel" + lvl, c_techCountCompleteOnly) == 0) {
                TechTreeUpgradeAddLevel(p, "TerranVehicleArmorsLevel" + lvl, 1);
            }
            if (TechTreeUpgradeCount(p, "TerranShipArmorsLevel" + lvl, c_techCountCompleteOnly) == 0) {
                TechTreeUpgradeAddLevel(p, "TerranShipArmorsLevel" + lvl, 1);
            }
        }
        n = n + 1;
    }
}

void libWoLU_DisableArmoryResearch (int p) {
    int i;
    // The Armory ONLY researches vehicle/ship weapon+armor LEVELS, and we never want the player to
    // research them directly: the vehicle/ship levels now SCALE WITH the infantry research instead.
    //
    // NEW FLOW (the infantry-scaling rework — replaces the v0.3.25–v0.3.31 grant-to-hide):
    //   * vehicle/ship weapon+armor levels come SOLELY from libWoLU_SyncWeaponArmorLevels, which grants
    //     the BASE Terran{Vehicle,Ship}{Weapons,Armors}Level{N} ids to MATCH the player's infantry
    //     weapons/armor research level N (0 infantry → 0 vehicle/ship; infantry 3/3 → vehicle/ship
    //     3/3). Mercs/heroes scale identically because those base-Level upgrades' real per-unit effects
    //     are GLOBAL EffectArrays reached by every unit id, and the player gets them per-player via the
    //     sync. NO static max-grant happens here anymore — the OLD unconditional grant of the 12 base +
    //     12 wrapper Level upgrades to max was the "+3 over-tune" (it stacked 3/3 on top of whatever the
    //     sync had granted), so it is REMOVED.
    //   * the Armory's research BUTTONS are hidden for the human player via a FLAG-GATED Show
    //     requirement in RequirementData.xml: each of the 24 ArmoryResearch Level buttons points at a
    //     CRequirement whose Show is a CRequirementAnd of the vanilla effective Show node AND
    //     WoLUNotCountFlag (NOT having WoLUnbalancedFlag). The human player HAS the flag → the AND is
    //     false → the button is hidden for the human; enemy Armories (no flag) keep their vanilla
    //     buttons (rule-9-safe — the Shaped-Blast flag-gate pattern). No grant-to-hide is needed, so
    //     the wrapper Level grants are gone too.
    //
    // This function now ONLY runs the belt-and-suspenders disable loop below.
    //
    // Belt-and-suspenders: DISABLE every ArmoryResearch command for the human player. 0..30 covers all
    // of them regardless of the exact command-index offset; a disable on a non-existent index is a
    // harmless no-op. The flag-gated Show requirement is the primary hide mechanism; this keeps the
    // commands disallowed even if a button slips the requirement. Player-only via TechTreeAbilityAllow(p,
    // ...) → enemy Armories untouched (rule 9).
    i = 0;
    while (i <= 30) {
        TechTreeAbilityAllow(p, AbilityCommand("ArmoryResearch", i), false);
        i = i + 1;
    }
}

// Heroes inherit the base units' cloak (Nova=Ghost, Tosh=Spectre) — the campaign
// already ships free-cloak behaviors, we just attach them to the heroes' units.
void libWoLU_AddBehaviorToType (int p, string unitType, string behavior) {
    unitgroup g;
    unit u;
    int i;
    g = UnitGroup(unitType, p, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    i = UnitGroupCount(g, c_unitCountAll);
    for ( ; i >= 1; i -= 1 ) {
        u = UnitGroupUnitFromEnd(g, i);
        if ((u != null) && (UnitBehaviorCount(u, behavior) == 0)) {
            UnitBehaviorAdd(u, behavior, u, 1);
        }
    }
}

// (Scripted auto-stim removed: the StimpackWoLU clone abilities carry real engine
// autocast — dashed circle included — defined in AbilData.xml.)

// (Removed: libWoLU_ToggleCloakOn. Every permanently-cloaked player unit now has its
// Cloak On/Off card buttons TOMBSTONED in UnitData.xml — the owner wants no cloak toggle
// buttons at all. With the buttons gone there is no decloak button to surface, so the
// trigger that issued the toggle's "On" command to sync the UI is obsolete and removed.
// The units stay permanently free-cloaked via PersonalCloakingFree/SpectreCloakingFree in
// the periodic above; the toggle ABILITY is kept on each base unit so enemies still cloak.)

// Siege Tank Graduating Range: each call adds ONE stack of WoLUGraduatingRange
// (+1 WeaponRange/stack) to the player's sieged tanks, up to 5. Fired on a 3 s
// periodic trigger, so range grows +1/3 s up to +5 while sieged; the buff lives on
// the sieged form only, so it resets on unsiege (matches the unit-table spec).
void libWoLU_GraduateSiegeRange (int p, string unitType) {
    unitgroup g;
    unit u;
    int i;
    g = UnitGroup(unitType, p, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    i = UnitGroupCount(g, c_unitCountAll);
    for ( ; i >= 1; i -= 1 ) {
        u = UnitGroupUnitFromEnd(g, i);
        if ((u != null) && (UnitBehaviorCount(u, "WoLUGraduatingRange") < 5)) {
            UnitBehaviorAdd(u, "WoLUGraduatingRange", u, 1);
        }
    }
}

// Predator Vespene Synthesis (AP): the player's Predators passively synthesize gas.
// Adds gas proportional to the number of living player Predators each tick. The
// PlayerModifyPropertyInt resource native + c_playerPropVespene constant are engine
// built-ins (used by the co-injected CampaignLib), so they resolve in this compile.
void libWoLU_SynthesizeVespene (int p) {
    unitgroup g;
    int n;
    g = UnitGroup("Predator", p, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    n = UnitGroupCount(g, c_unitCountAll);
    if (n > 0) {
        PlayerModifyPropertyInt(p, c_playerPropVespene, c_playerPropOperAdd, n * 5);
    }
}

bool libWoLU_OnGraduateRange (bool testConds, bool runActions) {
    if (PlayerRace(libWoLU_Player) == "Terr") {
        libWoLU_GraduateSiegeRange(libWoLU_Player, "SiegeTankSieged");
        libWoLU_GraduateSiegeRange(libWoLU_Player, "SiegeBreakerSieged");
        // Vespene Synthesis: +5 gas per living Predator on this 3 s tick (player-only).
        libWoLU_SynthesizeVespene(libWoLU_Player);
    }
    return true;
}

bool libWoLU_OnPeriodic (bool testConds, bool runActions) {
    if (PlayerRace(libWoLU_Player) == "Terr") {
        libWoLU_SyncWeaponArmorLevels(libWoLU_Player);
        // Rule 11 (user): EVERY cloak-capable player unit spawns + stays permanently
        // cloaked, for free. PersonalCloakingFree is a permanent-cloak buff
        // (Modification.StateFlags[Cloak]=1, no energy) — adding it makes the unit
        // invisible from the moment it appears. The 2 s period also catches units
        // trained mid-mission (≤2 s after spawn). Player-scoped by construction (rule 9).
        // SpectreCloakingFree is the spectre-flavoured variant (same effect).
        libWoLU_AddBehaviorToType(libWoLU_Player, "Ghost", "PersonalCloakingFree");
        libWoLU_AddBehaviorToType(libWoLU_Player, "Spectre", "SpectreCloakingFree");
        libWoLU_AddBehaviorToType(libWoLU_Player, "Banshee", "PersonalCloakingFree");
        libWoLU_AddBehaviorToType(libWoLU_Player, "Wraith", "PersonalCloakingFree");
        libWoLU_AddBehaviorToType(libWoLU_Player, "Reaper", "PersonalCloakingFree");
        libWoLU_AddBehaviorToType(libWoLU_Player, "Medivac", "PersonalCloakingFree");
        libWoLU_AddBehaviorToType(libWoLU_Player, "Predator", "PersonalCloakingFree");
        // Heroes inherit their base unit's cloak (Nova=Ghost, Tosh=Spectre).
        libWoLU_AddBehaviorToType(libWoLU_Player, "Nova", "PersonalCloakingFree");
        libWoLU_AddBehaviorToType(libWoLU_Player, "Tosh", "SpectreCloakingFree");
        // Mercs inherit their counterpart's cloak: Dusk Wings (Banshee), Winged
        // Nightmares (Wraith), Senior Ghost (Ghost), Death Heads (Reaper).
        libWoLU_AddBehaviorToType(libWoLU_Player, "DuskWing", "PersonalCloakingFree");
        libWoLU_AddBehaviorToType(libWoLU_Player, "MercWraith", "PersonalCloakingFree");
        libWoLU_AddBehaviorToType(libWoLU_Player, "MercSeniorGhost", "PersonalCloakingFree");
        // Death Heads (MercReaper, parent="Reaper") — base Reaper IS cloaked above but the
        // merc is a SEPARATE unit id, so the base-Reaper line never reached it (owner playtest:
        // Death Heads weren't cloaked). Reaper has NO toggle cloak ability, so like the base
        // Reaper/Medivac/Predator it needs ONLY the permanent buff (no ToggleCloakOn entry).
        libWoLU_AddBehaviorToType(libWoLU_Player, "MercReaper", "PersonalCloakingFree");
        // Viking family (owner, 0.3.11): the Viking is not normally cloak-capable, but the
        // owner wants the whole family permanently free-cloaked. Both modes get the buff
        // (VikingFighter=air, VikingAssault=ground) so cloak survives the in-place mode
        // morph; the 2 s period re-adds after a transform. The Viking has NO toggle cloak
        // ability, so like Reaper/Medivac/Predator it needs ONLY the permanent buff (no
        // ToggleCloakOn entry below).
        libWoLU_AddBehaviorToType(libWoLU_Player, "VikingFighter", "PersonalCloakingFree");
        libWoLU_AddBehaviorToType(libWoLU_Player, "VikingAssault", "PersonalCloakingFree");
        // Hel's Angels (Viking merc, both modes) — SEPARATE unit ids, so the base-Viking
        // lines above never reach them (the recurring "merc misses the buff" class).
        libWoLU_AddBehaviorToType(libWoLU_Player, "HelsAngelFighter", "PersonalCloakingFree");
        libWoLU_AddBehaviorToType(libWoLU_Player, "HelsAngelAssault", "PersonalCloakingFree");
        // Raven + Science Vessel (owner): not normally cloak-capable, so they have NO toggle
        // cloak ability → no card buttons to remove and none to add (behavior-only, exactly
        // like Reaper/Medivac/Predator/Viking). Permanent free cloak via PersonalCloakingFree;
        // per-player (rule-9-safe). Neither has a merc/hero counterpart, so no family fan-out.
        libWoLU_AddBehaviorToType(libWoLU_Player, "Raven", "PersonalCloakingFree");
        libWoLU_AddBehaviorToType(libWoLU_Player, "ScienceVessel", "PersonalCloakingFree");
        // (Removed: the per-unit libWoLU_ToggleCloakOn(...) calls. The owner wants NO cloak
        // toggle buttons on ANY permanently-cloaked player unit — every unit's Cloak On/Off
        // card buttons are now tombstoned in UnitData.xml (Ghost/Banshee/Wraith/Spectre +
        // mercs MercWraith/MercSeniorGhost; Nova/Tosh never had a toggle button pair — they
        // show a passive PermanentlyCloaked* display only). With no decloak button to surface,
        // the UI-sync trigger is gone. The units stay free-cloaked by the PersonalCloakingFree/
        // SpectreCloakingFree behaviors added above; the cloak ABILITY is kept on each base unit
        // so enemy ghosts/banshees/wraiths/spectres still cloak (rule 9).)
        // Predator Adaptive Defenses: permanent damage-halving buff (player-only).
        libWoLU_AddBehaviorToType(libWoLU_Player, "Predator", "WoLUAdaptiveDefenses");
        // Predator Charge (AP): permanent +120% move speed (player-only).
        libWoLU_AddBehaviorToType(libWoLU_Player, "Predator", "WoLUPredatorCharge");
        // Defensive Matrix on-damage auto-trigger (player-only): a hidden DamageResponse
        // buff (WoLUDefMatrixOnDamage) raises the Defensive Matrix shield on the DAMAGE
        // EVENT, throttled to 20 s (the buff's own duration) so it never re-casts while a
        // shield is already up. Applied to the shared BC + Science Vessel here (NOT a static
        // BehaviorArray edit — that would buff enemy BCs/SVs too) and to the player-exclusive
        // Jackson's Revenge (DukesRevenge), keeping all three uniform. Replaces the removed
        // WoLUCasterDamaged state-gate autocast on DefensiveMatrixWoLU / DukesRevengeDefensiveMatrixWoLU.
        libWoLU_AddBehaviorToType(libWoLU_Player, "Battlecruiser", "WoLUDefMatrixOnDamage");
        libWoLU_AddBehaviorToType(libWoLU_Player, "ScienceVessel", "WoLUDefMatrixOnDamage");
        libWoLU_AddBehaviorToType(libWoLU_Player, "DukesRevenge", "WoLUDefMatrixOnDamage");
        // SV passive auto-heal aura — heals all nearby friendlies (bio+mech+air), free,
        // player-only rule-9-safe; replaces the abandoned Medivac-beam heal transplant.
        libWoLU_AddBehaviorToType(libWoLU_Player, "ScienceVessel", "WoLUSVHealAura");
        // SV heal-GLOW cadence (v0.3.x): a separate 1.0 s behavior drives the visual pulse at a calm
        // once-per-second-per-healed-unit rate (the heal above stays granular at ~16x/s). Without this
        // the pulse fired on every heal tick (~16/s) = far too busy. Player-only (rule 9).
        libWoLU_AddBehaviorToType(libWoLU_Player, "ScienceVessel", "WoLUSVHealAuraGlow");
        // Raven SELF point-defense (v0.3.x): a PASSIVE periodic behavior that finds nearby enemy missiles
        // and applies the vanilla PointDefenseLaserDamage (nullify + blue beam from the Raven). Replaces
        // the old script-order interceptor, whose cast queued behind the move order and never fired while
        // the Raven was move-commanded — the behavior fires regardless of orders, so it now works WHILE
        // THE RAVEN MOVES/ATTACKS. Player-only (rule 9; enemy Ravens never get it). The Raven has no
        // merc/hero counterpart, so no family fan-out.
        libWoLU_AddBehaviorToType(libWoLU_Player, "Raven", "WoLURavenPointDefense");
        // Kill the leftover vanilla NanoRepair autocast on the player's SV (v0.3.25). The
        // NanoRepair card BUTTON was tombstoned (UnitData.xml LayoutButtons idx8), but the
        // NanoRepair ABILITY is still on the SV's AbilArray with ability-level AutoCast flags
        // (vanilla CAbilEffectTarget NanoRepair), so the SV kept single-target energy-draining
        // NanoRepair-autocasting — card removal does NOT stop autocast (it's ability-level).
        // Disallow the NanoRepair command for player 1 ONLY (command index 0 = the single Execute
        // of the CAbilEffectTarget) — same proven per-player lever as the ArmoryResearch disable
        // below. Enemy SVs (other players) keep vanilla NanoRepair (rule 9). With NanoRepair
        // silenced, the auto-heal AURA is the SV's ONLY heal.
        TechTreeAbilityAllow(libWoLU_Player, AbilityCommand("NanoRepair", 0), false);
    }
    return true;
}

// (Raven SCRIPT point-defense REMOVED v0.3.x — libWoLU_OnInterceptMissiles ORDERED the Raven to cast
// WoLURavenPDNullify, and that order queued BEHIND the Raven's move order so the nullify never fired
// while the Raven was move-commanded. Replaced by the PASSIVE periodic behavior WoLURavenPointDefense
// (BehaviorData → WoLURavenPDSearch → the vanilla PointDefenseLaserDamage), attached player-only to the
// Raven in libWoLU_OnPeriodic. A behavior periodic fires regardless of the order queue, so point-defense
// now works WHILE THE RAVEN MOVES/ATTACKS — that is the fix. The beam still draws Raven→missile because
// PointDefenseDroneAttackBeam binds to Effect.PointDefenseLaserDamage.Start; At Caster, and the behavior's
// caster is the Raven.)

//==================================================================================================
// "Skip Prophecy (Zeratul) missions" — one-time on-screen button (tstory01 only)
//
// A convenience for players who want to skip the optional Zeratul "Prophecy" arc but still
// receive its full research-point yield. Implemented PURELY in this trigger library (no XML,
// no GameStrings) — UI text is StringToText(...) literals matching the diag lines above.
//
// Placement: ONLY on tstory01 (libCamp_ge_MapID_MapTStory01 = the interactive Hyperion hub /
// star-map between missions). VERIFIED: libCamp_gv_tS_CurrentMap == libCamp_ge_MapID_MapTStory01
// is the campaign's own "in story mode" test (CampaignLib.galaxy:6089). build.py injects this
// library into every .SC2Map (incl. tstory01), so the gate below is what scopes it to the hub.
//
// The 4 Prophecy missions are libCamp_ge_MapID_MapTZeratul01..04 (= 22..25; CampaignLib_h.galaxy).
//==================================================================================================

// Gate: should the Skip-Prophecy button be offered right now? True only when ALL hold:
//   - we are on the tstory01 Hyperion hub, AND
//   - the human player is Terran (the campaign hero faction; Protoss interludes are skipped), AND
//   - the Prophecy arc is REACHABLE (TZeratul01 is UNLOCKED, i.e. NOT Locked) but NOT yet finished
//     (TZeratul04 not Completed). So the button is hidden before Tychus 02 unlocks the arc, and
//     after all four are done.
// NOTE (v0.3.15 fix): the gate now tests TZeratul01 != Locked, NOT == Available. libCamp_gf_MissionStatus
// (CampaignLib.galaxy:2767-2779) returns Available ONLY while a mission is unlocked-AND-not-completed —
// so the moment the player CLEARS TZeratul01 its status becomes Completed and an `== Available` gate
// would wrongly hide the button while TZeratul02-04 still remain. `!= Locked` (Available OR Completed)
// keeps the button up across the whole arc until TZeratul04 is done.
// libCamp_gf_MissionStatusCheck(mapID, status) (CampaignLib.galaxy:2781) and the
// MissionStatus_* enums (Locked, Available, Completed) are in scope via the co-injected CampaignLib.
bool libWoLU_ShouldOfferSkipProphecy (int p) {
    if (libCamp_gv_tS_CurrentMap != libCamp_ge_MapID_MapTStory01) {
        return false;
    }
    if (PlayerRace(p) != "Terr") {
        return false;
    }
    if (libCamp_gf_MissionStatusCheck(libCamp_ge_MapID_MapTZeratul01, libCamp_ge_MissionStatus_Locked) == true) {
        return false; // arc not unlocked yet → nothing to skip
    }
    if (libCamp_gf_MissionStatusCheck(libCamp_ge_MapID_MapTZeratul04, libCamp_ge_MissionStatus_Completed) == true) {
        return false; // arc already fully completed
    }
    return true;
}

// Create the one button + its host dialog (idempotent — only if not already created).
// Standard Galaxy dialog GUI idiom, copied from CampaignLib's own button blocks
// (e.g. CampaignLib.galaxy:13476-13505) and the Perpetual Randomizer's dialog triggers:
// DialogCreate → store DialogLastCreated; DialogControlCreate(button) → store
// DialogControlLastCreated; set text/size/position. The text uses the
// libNtve_gf_SetDialogItemText wrapper (the NativeLib idiom both CampaignLib and the rogue
// kit use for button captions) — our lib includes TriggerLibs/NativeLib, so it resolves.
//
// Position: anchored BOTTOM-center, ~90 px up from the bottom edge — clear of the native
// star-map / mission-launch panel that fills the upper/center of the screen.
//
// Visibility model (v0.3.20): the button is created ONCE, HIDDEN, and a periodic poll
// (libWoLU_OnStoryModeInit) flips its visibility so it shows ONLY on the star-map crystal
// with a Zeratul mission selected — NOT as a persistent overlay over every Hyperion room.
// So this creator NO LONGER shows the button; it starts hidden and the poll owns visibility.
//
// DialogSetRenderPriority raises the dialog's render/input layer ABOVE the native battle-report
// panel, so the button can render AND be clicked at the crystal (the native panel renders on top
// otherwise). 4096 is well above the engine's default dialog priority; the rogue kit uses 550 for
// an achievement popup over the same UI (mods/rogue/.../LibWoLC.galaxy:111). [GAME]-PENDING: the
// exact render-priority value and confirmed clickability at the crystal need an in-game check.
void libWoLU_CreateSkipProphecyButton () {
    if (libWoLU_gv_skipProphecyDialog != c_invalidDialogId) {
        return; // already created this visit — never make a second one
    }
    // Small dialog: 420x44, anchored bottom-center, +90 px up from the bottom edge.
    DialogCreate(420, 44, c_anchorBottom, 0, 90, false);
    libWoLU_gv_skipProphecyDialog = DialogLastCreated();
    // Start HIDDEN — the poll (libWoLU_OnStoryModeInit) decides when to show it.
    DialogSetVisible(libWoLU_gv_skipProphecyDialog, PlayerGroupAll(), false);
    // Render/input ABOVE the native battle-report panel so it's clickable at the crystal.
    DialogSetRenderPriority(libWoLU_gv_skipProphecyDialog, 4096);
    // The clickable button child, filling the dialog.
    DialogControlCreate(libWoLU_gv_skipProphecyDialog, c_triggerControlTypeButton);
    libWoLU_gv_skipProphecyButton = DialogControlLastCreated();
    libNtve_gf_SetDialogItemText(libWoLU_gv_skipProphecyButton, StringToText("Skip Prophecy Missions (grant research)"), PlayerGroupAll());
    DialogControlSetSize(libWoLU_gv_skipProphecyButton, PlayerGroupAll(), 420, 44);
    DialogControlSetPosition(libWoLU_gv_skipProphecyButton, PlayerGroupAll(), c_anchorBottom, 0, 0);
}

// Are we right now on the star-map "crystal" with a Zeratul mission selected?
// True iff ALL hold:
//   - on the tstory01 Hyperion hub (libCamp_gv_tS_CurrentMap == ...MapTStory01),
//   - the native battle-report panel (the star map) is open (UIFrameVisible(1, ...BattleReportPanel)),
//   - the currently-selected report (BattleReportPanelGetSelectedBattleReport(1)) is one of the four
//     Zeratul missions' battle-report ids (libCamp_gv_tS_BattleReportMissions[TZeratul01..04]), AND
//   - the Prophecy arc is still offerable (libWoLU_ShouldOfferSkipProphecy: arc unlocked, not finished).
// Signatures verified against the co-injected CampaignLib: UIFrameVisible(1, c_syncFrameTypeBattleReportPanel)
// (CampaignLib.galaxy:12319), BattleReportPanelGetSelectedBattleReport(1) (:12330), and the
// libCamp_gv_tS_BattleReportMissions[<mapID>] == selectedReport comparison (:12334). The four Zeratul
// map ids are contiguous (TZeratul01..04), so we index the array directly with each.
bool libWoLU_OnCrystalZeratulScreen (int p) {
    int selectedReport;
    if (libCamp_gv_tS_CurrentMap != libCamp_ge_MapID_MapTStory01) {
        return false; // Hyperion hub only
    }
    if (UIFrameVisible(1, c_syncFrameTypeBattleReportPanel) != true) {
        return false; // star map not open
    }
    if (libWoLU_ShouldOfferSkipProphecy(p) != true) {
        return false; // arc not unlocked yet, or already fully completed
    }
    selectedReport = BattleReportPanelGetSelectedBattleReport(1);
    if (selectedReport == c_invalidBattleReportId) {
        return false; // nothing selected
    }
    if (libCamp_gv_tS_BattleReportMissions[libCamp_ge_MapID_MapTZeratul01] == selectedReport) {
        return true;
    }
    if (libCamp_gv_tS_BattleReportMissions[libCamp_ge_MapID_MapTZeratul02] == selectedReport) {
        return true;
    }
    if (libCamp_gv_tS_BattleReportMissions[libCamp_ge_MapID_MapTZeratul03] == selectedReport) {
        return true;
    }
    if (libCamp_gv_tS_BattleReportMissions[libCamp_ge_MapID_MapTZeratul04] == selectedReport) {
        return true;
    }
    return false; // a non-Zeratul report is selected
}

// The action: mark all 4 Prophecy missions complete and grant their full research yield,
// then persist and remove the button. Player-1 / campaign-state only — never touches a unit,
// so rule 9 is preserved trivially.
//
// RESEARCH-YIELD CORRECTION (verified against CampaignLib, differs from the brief's literal
// formula — following the REAL semantics per the don't-guess discipline):
//   The persistent array libCamp_gv_tSX_ResearchMissionProgress[mission][category]
//   (CampaignLib_h.galaxy:784, shape [36][3], category 1=Protoss / 2=Zerg) stores ONLY the
//   per-mission RESEARCH-OPPORTUNITY points. The Lab total (libCamp_gf_StoryResearchPoints,
//   CampaignLib.galaxy:4853-4855) is computed, for each COMPLETED mission, as
//       array[mission][cat]  +  libCamp_gf_TS_MissionRewardResearchPoints(mission, cat)
//   i.e. the fixed mission-reward points are ADDED ON TOP of the array value once the mission is
//   Completed (the battle-report code at :4202-4207 confirms the same split). So the 100%-clear
//   yield = Opportunities (stored in the array) + Reward (added automatically when Completed).
//   Writing Opportunities+Reward INTO the array AND marking Completed (as the brief's literal
//   formula would) double-counts the Reward. We therefore store ONLY the OPPORTUNITY value
//   (libCamp_gf_TS_StoryResearchMissionOpportunities, CampaignLib.galaxy:5000); marking the
//   mission Completed below makes the engine add the Reward portion itself → exact 100% total,
//   no double-count. Computed at runtime (never hardcoded).
void libWoLU_SkipProphecyMissions (int p) {
    int m;
    int prot;
    int zerg;
    int protBefore;
    int zergBefore;

    // Capture the Lab research TOTALS before granting, so the confirmation below can report the
    // exact amount this skip added (lets the owner verify "all points given").
    // libCamp_gf_StoryResearchPoints (CampaignLib.galaxy:4828) sums, over every Completed mission,
    // the per-mission opportunity array + that mission's completion reward.
    protBefore = libCamp_gf_StoryResearchPoints(libCamp_ge_StoryResearchCategory_ResearchCategoryProtoss);
    zergBefore = libCamp_gf_StoryResearchPoints(libCamp_ge_StoryResearchCategory_ResearchCategoryZerg);

    // Iterate the four Prophecy mission ids (22..25 inclusive are exactly TZeratul01..04).
    m = libCamp_ge_MapID_MapTZeratul01;
    while (m <= libCamp_ge_MapID_MapTZeratul04) {
        // 1. Count the mission complete on EVERY difficulty (1..4), so it reads as cleared
        //    regardless of the player's campaign difficulty (CampaignLib.galaxy:3097).
        libCamp_gf_TS_SetMissionDifficultyCompleted(m, 1, true);
        libCamp_gf_TS_SetMissionDifficultyCompleted(m, 2, true);
        libCamp_gf_TS_SetMissionDifficultyCompleted(m, 3, true);
        libCamp_gf_TS_SetMissionDifficultyCompleted(m, 4, true);
        // 2. Flag the mission status as Completed (CampaignLib.galaxy:3059).
        libCamp_gf_TS_MarkMissionAsStatus(m, libCamp_ge_MissionStatus_Completed);
        // 3. Compute the 100%-clear OPPORTUNITY points per category at runtime (see header note;
        //    the Reward portion is added by the engine once Completed, so do NOT add it here).
        prot = libCamp_gf_TS_StoryResearchMissionOpportunities(m, libCamp_ge_StoryResearchCategory_ResearchCategoryProtoss);
        zerg = libCamp_gf_TS_StoryResearchMissionOpportunities(m, libCamp_ge_StoryResearchCategory_ResearchCategoryZerg);
        // 4. Write into the persistent array, never LOWERING an existing value (a partial
        //    clear may already have banked some points). Lab total = SUM over missions.
        if (libCamp_gv_tSX_ResearchMissionProgress[m][libCamp_ge_StoryResearchCategory_ResearchCategoryProtoss] < prot) {
            libCamp_gv_tSX_ResearchMissionProgress[m][libCamp_ge_StoryResearchCategory_ResearchCategoryProtoss] = prot;
        }
        if (libCamp_gv_tSX_ResearchMissionProgress[m][libCamp_ge_StoryResearchCategory_ResearchCategoryZerg] < zerg) {
            libCamp_gv_tSX_ResearchMissionProgress[m][libCamp_ge_StoryResearchCategory_ResearchCategoryZerg] = zerg;
        }
        m = m + 1;
    }

    // 5. Re-propagate the unlock chain so the now-complete missions don't leave downstream
    //    missions locked (CampaignLib.galaxy:2967 — it re-evaluates every mission's gate).
    libCamp_gf_UpdateMissionFlow();
    // 6. Persist via the campaign's OWN story-mode save (opens the bank, SaveTransitionVars
    //    Normal → writes all missions' research + completion, BankSave, SaveMissionBanks).
    //    This is the supported persistence path — do NOT hand-roll BankSave (CampaignLib.galaxy:8474).
    libCamp_gf_PrepareForStoryModeTransitionalSave();

    // 7. Destroy the dialog so the button can't be re-clicked, reset the sentinels, and confirm.
    if (libWoLU_gv_skipProphecyDialog != c_invalidDialogId) {
        DialogDestroy(libWoLU_gv_skipProphecyDialog);
    }
    libWoLU_gv_skipProphecyDialog = c_invalidDialogId;
    libWoLU_gv_skipProphecyButton = c_invalidDialogControlId;
    // Report the EXACT research this skip added (after - before) + the new Lab totals, so the
    // grant is verifiable in-game rather than just "some points".
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("Prophecy missions skipped. Research granted: +"
        + IntToString(libCamp_gf_StoryResearchPoints(libCamp_ge_StoryResearchCategory_ResearchCategoryProtoss) - protBefore) + " Protoss / +"
        + IntToString(libCamp_gf_StoryResearchPoints(libCamp_ge_StoryResearchCategory_ResearchCategoryZerg) - zergBefore) + " Zerg (Lab totals now "
        + IntToString(libCamp_gf_StoryResearchPoints(libCamp_ge_StoryResearchCategory_ResearchCategoryProtoss)) + " / "
        + IntToString(libCamp_gf_StoryResearchPoints(libCamp_ge_StoryResearchCategory_ResearchCategoryZerg)) + ")."));
}

// bool -> "1"/"0" for the diag subtitles below (Galaxy has no bool->string native).
string libWoLU_b2s (bool v) {
    if (v) {
        return "1";
    }
    return "0";
}

// Re-assert EVERY campaign merc as Purchased (BUG-1 fix, v0.3.15). When a counterpart-unlock
// mission completes (e.g. The Dig unlocks the Siege Tank), the campaign's own
// libCamp_gf_TS_UpdateMercStatus (CampaignLib.galaxy:3653-3656) flips that merc Locked->New —
// i.e. back to PURCHASABLE — and our main per-mission grant runs on GAME-time timers that may not
// advance on the story-mode Hyperion hub, so the merc panel shows a buy button there. Re-purchase
// here (called from the hub handler on a REAL-time timer). SetMercStatus(Purchased) is what hides
// the panel's buy button; UpdateMercStatus leaves an already-Purchased merc alone once its
// counterpart is enabled, so this is stable. Re-apply the merc tech/upgrades to keep calldowns +
// upgrades consistent. Idempotent; player-only (rule 9).
void libWoLU_PurchaseAllMercs (int p) {
    int i;
    i = libCamp_gv_TSC_MERC_FIRST;
    while (i <= libCamp_gv_TSC_MERC_LAST) {
        libCamp_gf_SetMercStatus(libCamp_gv_tS_MercID[i], libCamp_ge_StoryMercStatus_Purchased);
        i = i + 1;
    }
    libCamp_gf_TS_ApplyMercenaryTech(p);
    libCamp_gf_TS_ApplyMercUpgrades(p);
}

// Hub handler / Skip-Prophecy visibility poll — runs on the tstory01 Hyperion only. Wired
// (libWoLU_InitLib) on both game-time passes AND a ~0.5 s REAL-time periodic: the story-mode hub
// may not advance game time the way a combat mission does, so the real-time poll guarantees this
// fires (and keeps firing) on the Hyperion. Does three things there:
//   (1) re-purchase all mercs (BUG-1: Siege Breakers et al. stay owned, not buyable),
//   (2) ensure the Skip-Prophecy button is CREATED ONCE (hidden) while the arc is offerable,
//   (3) drive the button's VISIBILITY from libWoLU_OnCrystalZeratulScreen — visible exactly when
//       the player is on the star-map crystal with a Zeratul mission selected, hidden otherwise.
// This replaces the old "create-and-show, persistent overlay over every room" behavior: the button
// now appears ONLY on the Zeratul crystal screen and nowhere else (armory/cantina/lab and the star
// map for non-Zeratul missions all hide it). The poll is the reliable baseline; it covers panel
// open, selection change, and panel exit uniformly without flicker.
// Early-returns on every other map, so combat missions see nothing (no work).
bool libWoLU_OnStoryModeInit (bool testConds, bool runActions) {
    if (libCamp_gv_tS_CurrentMap != libCamp_ge_MapID_MapTStory01) {
        return true; // Hyperion hub only
    }
    libWoLU_PurchaseAllMercs(libWoLU_Player);
    // Ensure the button exists (hidden) while the arc is still offerable. The creator is guarded
    // (idempotent) and starts the button hidden, so this is safe to call every poll tick. Once the
    // skip is used, libWoLU_SkipProphecyMissions destroys the dialog AND the gate (ShouldOffer)
    // fails → it's never re-created, satisfying the one-time semantics.
    if (libWoLU_ShouldOfferSkipProphecy(libWoLU_Player) == true) {
        libWoLU_CreateSkipProphecyButton();
    }
    // Set visibility from the crystal-screen test. If the dialog hasn't been created yet (gate not
    // met), skip — there's nothing to show. DialogSetVisible takes the live boolean so the button
    // shows exactly on the Zeratul crystal screen and hides everywhere else, without flicker.
    if (libWoLU_gv_skipProphecyDialog != c_invalidDialogId) {
        DialogSetVisible(libWoLU_gv_skipProphecyDialog, PlayerGroupAll(), libWoLU_OnCrystalZeratulScreen(libWoLU_Player));
    }
    return true;
}

// Click handler: condition-gate on our exact button id first (the click event fires for ANY
// dialog control in the map, so non-matching clicks must early-return false), then run the skip.
bool libWoLU_OnSkipProphecyClicked (bool testConds, bool runActions) {
    if (testConds) {
        if (EventDialogControl() != libWoLU_gv_skipProphecyButton) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libWoLU_SkipProphecyMissions(libWoLU_Player);
    return true;
}

void libWoLU_InitLib () {
    trigger t;
    TriggerAddEventMapInit(TriggerCreate("libWoLU_OnMapInit"));
    // Grant slightly after init (mission setup applies vanilla tech first), with a
    // late second pass for missions that set up tech after intro sequences.
    t = TriggerCreate("libWoLU_OnGrantTech");
    TriggerAddEventTimeElapsed(t, 1.0, c_timeGame);
    TriggerAddEventTimeElapsed(t, 10.0, c_timeGame);
    TriggerAddEventTimePeriodic(TriggerCreate("libWoLU_OnPeriodic"), 2.0, c_timeGame);
    // Graduating Range ticks every 3 s (the spec's interval), independent of the 2 s
    // behavior-maintenance pass above.
    TriggerAddEventTimePeriodic(TriggerCreate("libWoLU_OnGraduateRange"), 3.0, c_timeGame);
    // (Removed: the libWoLU_OnInterceptMissiles 0.0625 s tick. Raven point-defense is now the PASSIVE
    // periodic behavior WoLURavenPointDefense — added player-only in libWoLU_OnPeriodic — which fires
    // regardless of the Raven's order queue, so it works while the Raven moves/attacks.)

    // Hyperion-hub handler (merc re-purchase + Skip-Prophecy button + diag; scoped to tstory01
    // inside the handler). Fires on BOTH game-time AND real-time passes: the story-mode hub may
    // not advance game time like a combat mission, so the real-time events guarantee it runs there
    // (this is the v0.3.15 fix for "button never appeared" + "Siege Breakers stayed buyable" — both
    // symptoms of the game-time grant not reaching the hub). The handler is idempotent and the
    // button creator is guarded, so multiple passes are harmless.
    t = TriggerCreate("libWoLU_OnStoryModeInit");
    TriggerAddEventTimeElapsed(t, 2.0, c_timeGame);
    TriggerAddEventTimeElapsed(t, 11.0, c_timeGame);
    TriggerAddEventTimeElapsed(t, 2.0, c_timeReal);
    TriggerAddEventTimeElapsed(t, 6.0, c_timeReal);
    // ~0.5 s REAL-time poll drives the Skip-Prophecy button's visibility (show only on the Zeratul
    // crystal screen) + keeps mercs re-purchased on the hub. Real-time because the story-mode hub
    // may not advance game time. The handler early-returns off tstory01, so this is free elsewhere.
    TriggerAddEventTimePeriodic(t, 0.5, c_timeReal);
    TriggerAddEventDialogControl(TriggerCreate("libWoLU_OnSkipProphecyClicked"), c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}
